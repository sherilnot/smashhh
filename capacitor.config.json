{
  "appId": "com.rizins.smash",
  "appName": "Rizins Smash",
  "webDir": "www",
  "server": {
    "url": "https://www.rizinssmash.com",
    "errorPath": "index.html",
    "allowNavigation": ["www.rizinssmash.com", "rizinssmash.com"],
    "cleartext": false
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#fdf8f0",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "StatusBar": {
      "style": "DARK",
      "overlaysWebView": true
    }
  }
}
