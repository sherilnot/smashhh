<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login — Rizins Smash</title>
  <link rel="stylesheet" href="/css/theme.css?v=5" />
</head>
<body>
  <div class="login-wrap">
    <div class="login-card">
      <div style="display: flex; flex-direction: column; align-items: center; margin-bottom: 1.5rem;">
        <img src="/images/logo-large.png" alt="Rizins Smash" style="height: 110px; width: auto; margin-bottom: 0.5rem;">
        <div class="brand-big" style="margin-bottom: 0.15rem;">Rizins Smash</div>
        <div class="tagline">Staff &amp; Shift Management</div>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="error"><%= error %></div>
      <% } %>

      <form method="POST" action="/login">
        <div class="form-group">
          <label for="user_id">User ID</label>
          <input type="text" id="user_id" name="user_id"
            value="<%= typeof userId !== 'undefined' && userId ? userId : '' %>"
            autocomplete="username" required />
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password"
            autocomplete="current-password" required />
        </div>
        <button type="submit" class="btn">Log In</button>
      </form>
    </div>
  </div>
</body>
</html>
