<%- include('../partials/header', { title: 'Book Shifts', role: 'employee', active: 'shifts' }) %>

  <h1>Book Shifts</h1>

  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <% if (typeof success !== 'undefined' && success) { %><div class="msg"><%= success %></div><% } %>

  <% 
    var canSubmit = typeof submissionStatus !== 'undefined' ? submissionStatus.canSubmit : false;
    var hasSubmitted = typeof submissionStatus !== 'undefined' ? submissionStatus.hasSubmitted : false;
    var submissionMessage = typeof submissionStatus !== 'undefined' ? submissionStatus.message : '';
    var inBookingWindow = typeof submissionStatus !== 'undefined' ? submissionStatus.inBookingWindow : false;
  %>

  <% if (hasSubmitted) { %>
    <div style="padding: 1rem; background: linear-gradient(135deg, #d4edda, #c3e6cb); border-radius: 12px; margin-bottom: 1.25rem;">
      <p style="margin: 0; color: #155724; font-size: 0.9rem;">
        ✅ Shifts previously submitted. You can update your selection below.
      </p>
    </div>
  <% } else if (!inBookingWindow) { %>
    <div style="padding: 1.25rem; background: linear-gradient(135deg, #fff3cd, #ffeaa7); border-radius: 12px; margin-bottom: 1.25rem;">
      <p style="margin: 0; color: #856404; font-weight: 600;">Booking Window Closed</p>
      <p style="margin: 0.5rem 0 0; color: #856404; font-size: 0.9rem;"><%= submissionMessage %></p>
    </div>
  <% } else { %>
    <div style="padding: 1rem; background: linear-gradient(135deg, #e3f2fd, #bbdefb); border-radius: 12px; margin-bottom: 1.25rem;">
      <p style="margin: 0; color: #0d47a1; font-size: 0.9rem;">
        📅 <strong>Booking Open!</strong> — <%= submissionMessage %>
      </p>
    </div>
  <% } %>

  <% if (typeof nextWeekDays !== 'undefined' && nextWeekDays.length > 0 && canSubmit) { %>
    <form method="POST" action="/employee/book-weekly-shifts" id="shiftForm">

      <!-- ═══ Quick Fill — set whole week at once ═══ -->
      <div style="background:var(--warm-white); border:1px solid var(--border); border-radius:12px; padding:0.85rem 1rem; margin-bottom:1rem;">
        <div style="font-size:0.75rem; font-weight:700; color:var(--muted); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:0.6rem;">
          ⚡ Quick Fill — Whole Week
        </div>
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(110px, 1fr)); gap:0.45rem;">
          <button type="button" onclick="fillWeek('11-2100')"
                  style="padding:0.6rem 0.5rem; font-size:0.82rem; font-weight:700; background:#e3f2fd; color:#1565c0; border:1.5px solid #90caf9; border-radius:9px; cursor:pointer;">
            ☀ Full Week<br><span style="font-size:0.68rem; font-weight:500; opacity:0.8;">Full days</span>
          </button>
          <button type="button" onclick="fillWeek('11-1730')"
                  style="padding:0.6rem 0.5rem; font-size:0.82rem; font-weight:700; background:#e8f5e9; color:#2e7d32; border:1.5px solid #a5d6a7; border-radius:9px; cursor:pointer;">
            🌅 All Mornings<br><span style="font-size:0.68rem; font-weight:500; opacity:0.8;">11:00–5:30</span>
          </button>
          <button type="button" onclick="fillWeek('1730-2100')"
                  style="padding:0.6rem 0.5rem; font-size:0.82rem; font-weight:700; background:#fff3e0; color:#e65100; border:1.5px solid #ffcc80; border-radius:9px; cursor:pointer;">
            🌆 All Evenings<br><span style="font-size:0.68rem; font-weight:500; opacity:0.8;">5:30–9:00</span>
          </button>
          <button type="button" onclick="fillWeek('none')"
                  style="padding:0.6rem 0.5rem; font-size:0.82rem; font-weight:700; background:#f5f5f5; color:#666; border:1.5px solid #ddd; border-radius:9px; cursor:pointer;">
            ✕ Clear All<br><span style="font-size:0.68rem; font-weight:500; opacity:0.8;">All days off</span>
          </button>
        </div>
        <p style="font-size:0.7rem; color:var(--muted); margin:0.5rem 0 0;">Applies to all days below — you can still adjust individual days after.</p>
      </div>

      <!-- Day Cards -->
      <div style="display: flex; flex-direction: column; gap: 0.75rem;">
        <% nextWeekDays.forEach(function(d, index) { %>
          <div class="day-card" id="card_<%= d.date %>" style="border: 2px solid var(--border); border-radius: 12px; padding: 1rem; background: white; transition: border-color 0.2s, box-shadow 0.2s;">
            
            <!-- Day Header -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <div>
                <span style="font-weight: 700; font-size: 1.1rem;"><%= d.label %></span>
                <span style="color: var(--muted); font-size: 0.85rem; margin-left: 0.5rem;"><%= formatDateShort(d.date) %></span>
              </div>
              <span class="selected-label" id="label_<%= d.date %>" style="font-size: 0.75rem; padding: 0.2rem 0.6rem; border-radius: 10px; background: #f0f0f0; color: var(--muted);">Off</span>
            </div>

            <!-- Shift Options -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
              
              <label class="shift-option" style="display: flex; align-items: center; gap: 0.6rem; padding: 0.7rem 0.75rem; border-radius: 8px; border: 1.5px solid #e0e0e0; cursor: pointer; transition: all 0.15s;">
                <input type="radio" name="shift_<%= d.date %>" value="11-1730" style="width: 18px; height: 18px; accent-color: #2e7d32;">
                <div>
                  <div style="font-weight: 600; font-size: 0.85rem; color: #2e7d32;">Morning</div>
                  <div style="font-size: 0.75rem; color: var(--muted);">11:00–5:30</div>
                </div>
              </label>

              <label class="shift-option" style="display: flex; align-items: center; gap: 0.6rem; padding: 0.7rem 0.75rem; border-radius: 8px; border: 1.5px solid #e0e0e0; cursor: pointer; transition: all 0.15s;">
                <input type="radio" name="shift_<%= d.date %>" value="1730-2100" style="width: 18px; height: 18px; accent-color: #e65100;">
                <div>
                  <div style="font-weight: 600; font-size: 0.85rem; color: #e65100;">Evening</div>
                  <div style="font-size: 0.75rem; color: var(--muted);">5:30–9:00</div>
                </div>
              </label>

              <label class="shift-option" style="display: flex; align-items: center; gap: 0.6rem; padding: 0.7rem 0.75rem; border-radius: 8px; border: 1.5px solid #e0e0e0; cursor: pointer; transition: all 0.15s;">
                <input type="radio" name="shift_<%= d.date %>" value="11-2100" style="width: 18px; height: 18px; accent-color: #1565c0;">
                <div>
                  <div style="font-weight: 600; font-size: 0.85rem; color: #1565c0;">Full Day</div>
                  <div style="font-size: 0.75rem; color: var(--muted);">11:00–9:00</div>
                </div>
              </label>

              <label class="shift-option" style="display: flex; align-items: center; gap: 0.6rem; padding: 0.7rem 0.75rem; border-radius: 8px; border: 1.5px solid #e0e0e0; cursor: pointer; transition: all 0.15s;">
                <input type="radio" name="shift_<%= d.date %>" value="none" checked style="width: 18px; height: 18px;">
                <div>
                  <div style="font-weight: 600; font-size: 0.85rem; color: #666;">No Shift</div>
                  <div style="font-size: 0.75rem; color: var(--muted);">Day off</div>
                </div>
              </label>
            </div>

            <!-- Custom Option -->
            <div style="margin-top: 0.5rem;">
              <label class="shift-option" style="display: flex; align-items: center; gap: 0.6rem; padding: 0.7rem 0.75rem; border-radius: 8px; border: 1.5px solid #e0e0e0; cursor: pointer; transition: all 0.15s;">
                <input type="radio" name="shift_<%= d.date %>" value="custom" class="custom-radio" data-date="<%= d.date %>" style="width: 18px; height: 18px; accent-color: #7b1fa2;">
                <div style="flex: 1;">
                  <div style="font-weight: 600; font-size: 0.85rem; color: #7b1fa2;">Custom</div>
                  <div class="custom-times" id="custom_<%= d.date %>" style="display: none; margin-top: 0.5rem;">
                    <div style="display: flex; gap: 0.4rem; align-items: center;">
                      <input type="time" name="custom_start_<%= d.date %>" style="padding: 0.4rem; border: 1px solid var(--line); border-radius: 6px; font-size: 0.9rem; width: 110px;">
                      <span style="color: var(--muted);">to</span>
                      <input type="time" name="custom_end_<%= d.date %>" style="padding: 0.4rem; border: 1px solid var(--line); border-radius: 6px; font-size: 0.9rem; width: 110px;">
                    </div>
                  </div>
                </div>
              </label>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- Submit Button -->
      <div style="position: sticky; bottom: 0; padding: 1rem 0; background: var(--warm-white); margin-top: 1rem; border-top: 1px solid var(--border);">
        <button type="submit" style="width: 100%; padding: 0.9rem; font-size: 1rem; font-weight: 700; background: linear-gradient(135deg, #2e7d32, #388e3c); color: white; border: none; border-radius: 12px; cursor: pointer; box-shadow: 0 4px 12px rgba(46,125,50,0.3);">
          <%= hasSubmitted ? 'Update Shifts' : 'Submit Shifts' %>
        </button>
        <p style="margin: 0.5rem 0 0; text-align: center; color: var(--muted); font-size: 0.8rem;">
          <%= hasSubmitted ? 'Your previous pending shifts will be replaced' : 'Select at least one shift before submitting' %>
        </p>
      </div>
    </form>

  <% } else if (typeof nextWeekDays !== 'undefined' && nextWeekDays.length > 0 && !canSubmit) { %>
    <div style="padding: 2rem; background: var(--bg-soft); border-radius: 12px; text-align: center;">
      <p style="color: var(--muted); font-size: 1rem; margin: 0;">
        Shift booking is not available right now.<br><%= submissionMessage %>
      </p>
    </div>
  <% } %>

  <style>
    .shift-option:has(input:checked) {
      border-color: #f4a300 !important;
      background: rgba(244, 163, 0, 0.05);
      box-shadow: 0 0 0 1px rgba(244, 163, 0, 0.3);
    }
    .day-card.has-selection {
      border-color: #f4a300;
      box-shadow: 0 2px 8px rgba(244, 163, 0, 0.1);
    }
  </style>

  <script>
    var shiftLabels = {
      '11-1730': 'Morning',
      '1730-2100': 'Evening',
      '11-2100': 'Full Day',
      'custom': 'Custom',
      'none': 'Off'
    };
    var shiftColors = {
      '11-1730': { bg: '#e8f5e9', color: '#2e7d32' },
      '1730-2100': { bg: '#fff3e0', color: '#e65100' },
      '11-2100': { bg: '#e3f2fd', color: '#1565c0' },
      'custom': { bg: '#f3e5f5', color: '#7b1fa2' },
      'none': { bg: '#f0f0f0', color: '#666' }
    };

    // ─── Quick fill: apply a shift type to every day ───
    function fillWeek(value) {
      document.querySelectorAll('.day-card').forEach(function(card) {
        var date = card.id.replace('card_', '');
        var radio = document.querySelector('input[name="shift_' + date + '"][value="' + value + '"]');
        if (radio) {
          radio.checked = true;
          radio.dispatchEvent(new Event('change', { bubbles: true }));
        }
      });
    }

    document.querySelectorAll('input[type="radio"]').forEach(function(radio) {
      radio.addEventListener('change', function() {
        var date = this.name.replace('shift_', '');
        var card = document.getElementById('card_' + date);
        var label = document.getElementById('label_' + date);
        var customDiv = document.getElementById('custom_' + date);
        var value = this.value;
        if (!card || !label) return;

        // Update label
        label.textContent = shiftLabels[value] || 'Off';
        var colors = shiftColors[value] || shiftColors['none'];
        label.style.background = colors.bg;
        label.style.color = colors.color;

        // Card highlight
        if (value !== 'none') {
          card.classList.add('has-selection');
        } else {
          card.classList.remove('has-selection');
        }

        // Custom times
        if (customDiv) {
          customDiv.style.display = value === 'custom' ? 'block' : 'none';
        }
      });
    });

    // Form validation
    document.getElementById('shiftForm').addEventListener('submit', function(e) {
      var selected = 0;
      document.querySelectorAll('input[type="radio"]:checked').forEach(function(r) {
        if (r.value !== 'none') selected++;
      });
      if (selected === 0) {
        e.preventDefault();
        alert('Please select at least one shift before submitting.');
        return;
      }
      if (!confirm('Submit ' + selected + ' shift' + (selected > 1 ? 's' : '') + '? You cannot change this until next week.')) {
        e.preventDefault();
      }
    });
  </script>

<%- include('../partials/footer') %>
