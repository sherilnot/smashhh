<%- include('../partials/header', { title: 'Cash Submission', role: 'store_manager', active: 'cash' }) %>

  <h1>Cash Submission</h1>
  <p style="color: var(--text-muted); margin-bottom: 1.25rem;">Send photos of liquid cash received (apart from online payments) to Operations Manager.</p>

  <% if (error) { %>
    <div class="error"><%= error %></div>
  <% } %>

  <% if (success) { %>
    <div class="msg">✅ Cash report submitted successfully to OM001!</div>
  <% } %>

  <div class="card" style="margin-bottom: 1.5rem;">
    <h2 style="margin-top: 0; font-size: 1.1rem;">New Cash Report</h2>
    <form method="POST" action="/manager/cash/submit" enctype="multipart/form-data">
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <div>
          <label style="font-weight: 600; display: block; margin-bottom: 0.4rem;">Amount ($)</label>
          <input type="number" name="amount" step="0.01" min="0" required
                 placeholder="e.g. 350.00"
                 style="width: 200px; padding: 8px; border: 1px solid var(--border); border-radius: 6px; font-size: 1.1rem;">
        </div>

        <div>
          <label style="font-weight: 600; display: block; margin-bottom: 0.4rem;">Photos (max 5 images)</label>
          <input type="file" name="photos" accept="image/*" multiple required
                 style="padding: 6px;">
          <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.3rem;">
            Take a photo of the cash or upload from gallery. Max 10MB per image.
          </div>
        </div>

        <div>
          <label style="font-weight: 600; display: block; margin-bottom: 0.4rem;">Note (optional)</label>
          <textarea name="notes" placeholder="Any details about this cash..."
                    style="width: 100%; padding: 8px; border: 1px solid var(--border); border-radius: 6px; min-height: 60px; resize: vertical;"></textarea>
        </div>

        <div>
          <button type="submit" class="btn" style="background: linear-gradient(180deg, var(--green), #388E3C); color: white; padding: 10px 24px;">
            📸 Submit to OM001
          </button>
        </div>
      </div>
    </form>
  </div>

  <% if (submissions && submissions.length > 0) { %>
    <h2 style="font-size: 1.1rem;">Previous Submissions</h2>
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Amount</th>
          <th>Photos</th>
          <th>Notes</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% submissions.forEach(function(sub) { %>
          <tr>
            <td><%= new Date(sub.submitted_at).toLocaleString('en-AU', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) %></td>
            <td style="font-weight: 600;">$<%= parseFloat(sub.amount).toFixed(2) %></td>
            <td><%= sub.image_count %> image<%= sub.image_count > 1 ? 's' : '' %></td>
            <td style="color: var(--text-muted); max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= sub.notes || '-' %></td>
            <td>
              <% if (sub.status === 'reviewed') { %>
                <span class="badge" style="background: var(--green); color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem;">REVIEWED</span>
              <% } else { %>
                <span class="badge" style="background: var(--accent); color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem;">SENT</span>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>

<%- include('../partials/footer') %>
