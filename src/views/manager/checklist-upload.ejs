<%- include('../partials/header', { title: 'Upload Checklist' }) %>

<div style="max-width: 900px; margin: 0 auto; padding: 20px;">
  <h1>Upload Checklist to Warehouse Manager</h1>

  <% if (error) { %>
    <div style="background: #fee; border: 1px solid #c00; padding: 12px; border-radius: 4px; margin-bottom: 16px;">
      <%= error %>
    </div>
  <% } %>

  <% if (success) { %>
    <div style="background: #efe; border: 1px solid #0a0; padding: 12px; border-radius: 4px; margin-bottom: 16px;">
      Successfully uploaded <%= uploadedCount %> checklist item(s) to the warehouse manager.
    </div>
  <% } %>

  <% if (items && items.length > 0) { %>
    <p style="margin-bottom: 12px;">The following completed items are ready to upload:</p>

    <table style="width: 100%; border-collapse: collapse;">
      <thead>
        <tr style="background: #333; color: #fff;">
          <th style="padding: 10px; text-align: left;">Product</th>
          <th style="padding: 10px; text-align: left;">Code</th>
          <th style="padding: 10px; text-align: right;">Expected</th>
          <th style="padding: 10px; text-align: right;">Actual</th>
          <th style="padding: 10px; text-align: center;">Status</th>
          <th style="padding: 10px; text-align: left;">Date</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(item => { %>
          <tr style="border-bottom: 1px solid #eee;">
            <td style="padding: 8px;"><%= item.product_name %></td>
            <td style="padding: 8px;"><%= item.product_code %></td>
            <td style="padding: 8px; text-align: right;"><%= item.expected_quantity %></td>
            <td style="padding: 8px; text-align: right;"><%= item.actual_quantity != null ? item.actual_quantity : '—' %></td>
            <td style="padding: 8px; text-align: center;">
              <span style="padding: 2px 8px; border-radius: 3px; font-size: 12px; background: <%= item.status === 'arrived' ? '#d4edda' : item.status === 'partial' ? '#fff3cd' : '#f8d7da' %>;">
                <%= item.status %>
              </span>
            </td>
            <td style="padding: 8px;"><%= item.check_date ? new Date(item.check_date).toISOString().split('T')[0] : '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <% if (!hasPendingItems) { %>
      <form method="POST" action="/manager/checklist-upload" style="margin-top: 16px;">
        <button type="submit" style="background: #333; color: #fff; border: none; padding: 10px 24px; border-radius: 4px; cursor: pointer; font-size: 16px;">
          Upload to Warehouse Manager (<%= items.length %> items)
        </button>
      </form>
    <% } else { %>
      <p style="color: #c00; margin-top: 12px;">Some checklist items are still pending. All items must be completed before upload.</p>
    <% } %>
  <% } else if (!error) { %>
    <p style="color: #666; text-align: center; padding: 40px 0;">No items available for upload. All checklist items have been transmitted or none are completed.</p>
  <% } %>

  <p style="margin-top: 20px;"><a href="/manager/dashboard">&larr; Back to Dashboard</a></p>
</div>

<%- include('../partials/footer') %>
