<%- include('../partials/header', { title: 'Employees - Burger Store', role: 'store_manager', active: 'employees' }) %>

  <h1><span class="emoji">🧑‍🍳</span>Employees</h1>

  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <div id="msg"></div>

  <h2 style="margin-top: 1.5rem;">Permanent Staff</h2>
  <% if (permanent.length === 0) { %>
    <div class="empty">No permanent employees at this store.</div>
  <% } else { %>
    <table>
      <thead>
        <tr><th>User ID</th><th>Name</th><th>Hourly Rate</th></tr>
      </thead>
      <tbody>
        <% permanent.forEach(emp => { %>
        <tr>
          <td><%= emp.user_id %></td>
          <td><%= emp.first_name %> <%= emp.last_name %></td>
          <td>$<%= parseFloat(emp.hourly_wage).toFixed(2) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>

  <h2 style="margin-top: 2rem;">Casual Staff</h2>
  <% if (casual.length === 0) { %>
    <div class="empty">No casual employees at this store.</div>
  <% } else { %>
    <table>
      <thead>
        <tr><th>User ID</th><th>Name</th><th>Hourly Rate</th></tr>
      </thead>
      <tbody>
        <% casual.forEach(emp => { %>
        <tr>
          <td><%= emp.user_id %></td>
          <td><%= emp.first_name %> <%= emp.last_name %></td>
          <td>$<%= parseFloat(emp.hourly_wage).toFixed(2) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>

<%- include('../partials/footer') %>
