<%- include('../partials/header', { title: 'Maintenance Report', role: 'store_manager', active: 'maintenance' }) %>

  <h1>Maintenance Report</h1>
  <p style="color: var(--text-secondary); margin-bottom: 1.25rem;">Report maintenance issues with photos and description. Sent to Operations Manager.</p>

  <% if (error) { %>
    <div class="error"><%= error %></div>
  <% } %>

  <% if (success) { %>
    <div class="msg">✅ Maintenance report submitted successfully!</div>
  <% } %>

  <div class="card" style="margin-bottom: 1.5rem;">
    <h2 style="margin-top: 0; font-size: 1.1rem;">New Report</h2>
    <form method="POST" action="/manager/maintenance/submit" enctype="multipart/form-data">
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <div>
          <label style="font-weight: 600; display: block; margin-bottom: 0.4rem;">Description</label>
          <textarea name="description" required placeholder="Describe the issue (e.g., broken fridge, leaking tap, damaged equipment...)"
                    style="width: 100%; padding: 10px; border: 1px solid var(--border); border-radius: 6px; min-height: 100px; resize: vertical; font-size: 0.95rem;"></textarea>
        </div>

        <div>
          <label style="font-weight: 600; display: block; margin-bottom: 0.4rem;">Photos (optional, max 5)</label>
          <input type="file" name="photos" accept="image/*" multiple style="padding: 6px;">
          <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 0.3rem;">
            Take a photo of the issue or upload from gallery. Max 10MB per image.
          </div>
        </div>

        <div>
          <button type="submit" class="btn" style="background: linear-gradient(135deg, var(--ketchup), #d62828); color: white; padding: 10px 24px;">
            🔧 Submit Report
          </button>
        </div>
      </div>
    </form>
  </div>

  <% if (reports && reports.length > 0) { %>
    <h2 style="font-size: 1.1rem;">Previous Reports</h2>
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Description</th>
          <th>Photos</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% reports.forEach(function(r) { %>
          <tr>
            <td><%= formatDateTime(r.submitted_at) %></td>
            <td style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= r.description %></td>
            <td><%= r.image_count %> image<%= r.image_count > 1 ? 's' : '' %></td>
            <td>
              <% if (r.status === 'reviewed') { %>
                <span class="badge" style="background: var(--green); color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem;">REVIEWED</span>
              <% } else { %>
                <span class="badge" style="background: var(--ketchup); color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem;">SENT</span>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>

<%- include('../partials/footer') %>
