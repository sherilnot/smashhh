<%- include('../partials/header', { title: 'Maintenance Report', role: 'store_manager', active: 'maintenance' }) %>

  <h1>Maintenance Report</h1>

  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <% if (success) { %><div class="msg">✅ Report submitted!</div><% } %>

  <!-- Submit Form -->
  <form method="POST" action="/manager/maintenance/submit" enctype="multipart/form-data">
    <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.5rem;">

      <div style="background: var(--warm-white); border: 1px solid var(--border); border-radius: 12px; padding: 0.85rem 1rem;">
        <label style="font-weight: 600; font-size: 0.8rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 0.4rem;">Description</label>
        <textarea name="description" required placeholder="Describe the issue (e.g., broken fridge, leaking tap...)"
                  style="width: 100%; padding: 0.6rem; border: 1px solid var(--border); border-radius: 8px; min-height: 100px; resize: vertical; font-size: 0.9rem; background: var(--cream);"></textarea>
      </div>

      <div style="background: var(--warm-white); border: 1px solid var(--border); border-radius: 12px; padding: 0.85rem 1rem;">
        <label style="font-weight: 600; font-size: 0.8rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 0.5rem;">📷 Photos &amp; 🎥 Videos (optional)</label>

        <!-- Hidden real input -->
        <input type="file" id="mediaInput" name="media" accept="image/*,video/*" multiple
               style="display: none;" onchange="updateFileList(this)">

        <!-- Custom trigger buttons -->
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.6rem;">
          <button type="button" onclick="document.getElementById('mediaInput').click()"
                  style="padding: 0.55rem 1rem; font-size: 0.85rem; font-weight: 600; background: var(--cream); border: 1px solid var(--border); border-radius: 8px; cursor: pointer; display: flex; align-items: center; gap: 0.35rem;">
            📎 Add Photos / Videos
          </button>
        </div>

        <!-- File preview list -->
        <div id="fileList" style="font-size: 0.8rem; color: var(--muted);"></div>
        <div style="font-size: 0.75rem; color: var(--muted); margin-top: 0.25rem;">Photos and videos accepted · Max 100 MB per file</div>
      </div>
    </div>

    <button type="submit" style="width: 100%; padding: 0.9rem; font-size: 1rem; font-weight: 700; background: linear-gradient(135deg, #8B6914, #A07D1A); color: white; border: none; border-radius: 12px; cursor: pointer; box-shadow: 0 4px 16px rgba(139,105,20,0.3); display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
      Submit Maintenance Report
    </button>
  </form>

  <% if (reports && reports.length > 0) { %>
    <h2 style="margin-top: 2rem; font-size: 1rem; color: var(--muted);">Previous Reports</h2>
    <div style="display: flex; flex-direction: column; gap: 0.4rem;">
      <% reports.forEach(function(r) { %>
        <div style="display: flex; align-items: center; gap: 0.75rem; padding: 0.7rem 0.85rem; background: var(--warm-white); border: 1px solid var(--border); border-radius: 10px;">
          <div style="flex: 1; min-width: 0;">
            <div style="font-weight: 600; font-size: 0.9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= r.description %></div>
            <div style="font-size: 0.75rem; color: var(--muted);">
              <%= formatDateTime(r.submitted_at) %>
              <% if (parseInt(r.image_count) > 0) { %>
                · 📷 <%= r.image_count %> photo<%= parseInt(r.image_count) !== 1 ? 's' : '' %>
              <% } %>
              <% if (parseInt(r.video_count) > 0) { %>
                · 🎥 <%= r.video_count %> video<%= parseInt(r.video_count) !== 1 ? 's' : '' %>
              <% } %>
            </div>
          </div>
          <% if (r.status === 'reviewed') { %>
            <span style="font-size: 0.7rem; padding: 0.2rem 0.5rem; background: #e8f5e9; color: #2e7d32; border-radius: 8px; font-weight: 600; flex-shrink: 0;">REVIEWED</span>
          <% } else { %>
            <span style="font-size: 0.7rem; padding: 0.2rem 0.5rem; background: #fce4ec; color: #c62828; border-radius: 8px; font-weight: 600; flex-shrink: 0;">SENT</span>
          <% } %>
        </div>
      <% }); %>
    </div>
  <% } %>

  <script>
    function updateFileList(input) {
      var list = document.getElementById('fileList');
      list.innerHTML = '';
      if (!input.files || input.files.length === 0) return;
      var items = [];
      for (var i = 0; i < input.files.length; i++) {
        var f = input.files[i];
        var icon = f.type.startsWith('video/') ? '🎥' : '📷';
        var size = f.size > 1024 * 1024
          ? (f.size / (1024 * 1024)).toFixed(1) + ' MB'
          : (f.size / 1024).toFixed(0) + ' KB';
        items.push(icon + ' ' + f.name + ' <span style="color:#aaa;">(' + size + ')</span>');
      }
      list.innerHTML = items.join('<br>');
    }
  </script>

<%- include('../partials/footer') %>
