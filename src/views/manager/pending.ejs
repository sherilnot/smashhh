<%- include('../partials/header', { title: 'Pending Requests - Burger Store', role: 'store_manager', active: 'pending' }) %>

  <h1>Pending Requests</h1>

  <% if (error) { %><div class="error"><%= error %></div><% } %>

  <% if (!hasManagedStore) { %>
    <div class="notice">No store assigned. You are not currently managing any store, so there are no pending requests to review.</div>
  <% } else if (requests.length === 0) { %>
    <p class="empty">No pending requests at this time.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Employee</th>
          <th>Day</th>
          <th>Shift Start</th>
          <th>Shift End</th>
          <th>Store</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% requests.forEach(request => { 
          const startDate = new Date(request.shiftStartTime);
          const endDate = new Date(request.shiftEndTime);
          const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
          const dayName = dayNames[startDate.getDay()];
        %>
          <tr>
            <td><%= request.employeeName %></td>
            <td><%= dayName %></td>
            <td><%= startDate.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}) %></td>
            <td><%= endDate.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}) %></td>
            <td><%= request.storeName || 'Store ' + request.storeId.substring(0, 8) %></td>
            <td>
              <div class="actions">
                <form method="POST" action="/manager/confirm">
                  <input type="hidden" name="bookingId" value="<%= request.bookingId %>" />
                  <button type="submit" class="confirm-btn">Confirm</button>
                </form>
                <form method="POST" action="/manager/reject">
                  <input type="hidden" name="bookingId" value="<%= request.bookingId %>" />
                  <button type="submit" class="reject-btn">Reject</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>

<%- include('../partials/footer') %>
