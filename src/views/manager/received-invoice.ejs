<%- include('../partials/header', { title: 'Received Invoice', role: 'store_manager', active: 'invoice' }) %>

  <h1>Received Invoice</h1>

  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <% if (typeof locals !== 'undefined' && locals.query && locals.query.success === '1') { %>
    <div class="msg">✅ Invoice submitted successfully!</div>
  <% } %>

  <% var recent = typeof recentInvoices !== 'undefined' ? recentInvoices : []; %>

  <% if (!invoice && !checklistPending) { %>
    <!-- ══ LIST VIEW — show recent invoices ══ -->
    <% if (recent.length > 0) { %>
      <p style="font-size:0.82rem; color:var(--muted); margin-bottom:0.75rem;">Tap a date to open the invoice</p>
      <div style="display:flex; flex-direction:column; gap:0.4rem;">
        <% recent.forEach(function(ri) { %>
          <%
            // Use local calendar parts, not toISOString(), so the date doesn't
            // shift back a day in timezones ahead of UTC.
            var dateStr;
            if (typeof ri.invoice_date === 'string') {
              dateStr = ri.invoice_date.substring(0, 10);
            } else {
              var _d = new Date(ri.invoice_date);
              dateStr = _d.getFullYear() + '-' + String(_d.getMonth() + 1).padStart(2, '0') + '-' + String(_d.getDate()).padStart(2, '0');
            }
            var statusLabel = ri.status === 'submitted' ? '✓ Submitted' : ri.status === 'new' ? '+ New' : '✏ Draft';
            var statusBg = ri.status === 'submitted' ? '#e8f5e9' : ri.status === 'new' ? '#e3f2fd' : '#fef3e2';
            var statusColor = ri.status === 'submitted' ? '#2e7d32' : ri.status === 'new' ? '#1565c0' : '#e65100';

            // Weekday name for context
            var dParts = dateStr.split('-');
            var dObj = new Date(Number(dParts[0]), Number(dParts[1]) - 1, Number(dParts[2]));
            var weekday = dObj.toLocaleDateString('en-AU', { weekday: 'long' });
          %>
          <a href="/manager/received-invoice?date=<%= dateStr %>"
             style="display:flex; align-items:center; justify-content:space-between; padding:0.85rem 1.1rem; background:var(--warm-white); border:1px solid var(--border); border-radius:12px; text-decoration:none; color:var(--ink); box-shadow:var(--shadow);">
            <div>
              <div style="font-weight:700; font-size:0.95rem;"><%= formatDate(dateStr) %></div>
              <div style="font-size:0.72rem; color:var(--muted);"><%= weekday %></div>
            </div>
            <span style="font-size:0.72rem; padding:0.2rem 0.6rem; background:<%= statusBg %>; color:<%= statusColor %>; border-radius:8px; font-weight:700;"><%= statusLabel %></span>
          </a>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty">No invoices yet.</div>
    <% } %>

    <!-- No separate button needed — today/tomorrow are in the list -->

  <% } else if (typeof checklistPending !== 'undefined' && checklistPending) { %>
    <div class="card" style="text-align:center; padding:2rem;">
      <div style="font-size:2.5rem; margin-bottom:0.75rem;">📋</div>
      <h2 style="margin:0 0 0.5rem;">Checklist Required First</h2>
      <p style="color:var(--text-muted); margin-bottom:1.25rem;">Create today's daily checklist before creating an invoice.</p>
      <a href="/manager/store-checklist" class="btn" style="background:linear-gradient(180deg,var(--accent),var(--accent-dark)); color:white; padding:10px 20px;">Go to Daily Checklist</a>
    </div>
  <% } else if (!invoice) { %>
    <div class="empty">Unable to load invoice. Make sure you're assigned to a store.</div>
  <% } else { %>

  <!-- Back link -->
  <a href="/manager/received-invoice" style="display:inline-flex; align-items:center; gap:0.3rem; font-size:0.82rem; color:var(--muted); text-decoration:none; margin-bottom:0.75rem; font-weight:600;">
    ← All Invoices
  </a>

  <style>
    .inv-wrap { background:#fff; border:1px solid var(--border); border-radius:12px; overflow:hidden; margin-bottom:1rem; }
    .inv-head { padding:1rem 1.25rem; background:#1b2a5e; color:#fff; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem; }
    .inv-head .company { font-size:1.1rem; font-weight:800; }
    .inv-head .inv-label { font-size:1.3rem; font-weight:800; letter-spacing:1px; opacity:0.9; }
    .inv-meta { display:flex; flex-wrap:wrap; gap:0.4rem 1.5rem; padding:0.75rem 1.25rem; background:#f7f9fc; border-bottom:1px solid #e8edf5; font-size:0.8rem; }
    .inv-meta .block .lbl { font-size:0.62rem; font-weight:700; text-transform:uppercase; color:#888; letter-spacing:0.4px; }
    .inv-meta .block .val { font-weight:600; color:#1b2a5e; }

    /* Table — always table, horizontally scrollable on mobile */
    .inv-table-wrap { overflow-x:auto; -webkit-overflow-scrolling:touch; }
    .inv-tbl { width:100%; border-collapse:collapse; font-size:0.82rem; min-width:520px; }
    .inv-tbl thead th { background:#1b2a5e; color:#fff; font-size:0.68rem; text-transform:uppercase; padding:0.5rem 0.6rem; font-weight:700; white-space:nowrap; text-align:left; }
    .inv-tbl thead th.ac { text-align:center; }
    .inv-tbl thead th.ar { text-align:right; }
    .inv-tbl tbody tr { border-bottom:1px solid #eef0f6; }
    .inv-tbl tbody tr:nth-child(odd) { background:#f7f9fc; }
    .inv-tbl tbody tr:nth-child(even) { background:#fff; }
    .inv-tbl tbody tr.editable:active { background:#fffbf0; }
    .inv-tbl tbody td { padding:0.5rem 0.6rem; color:#222; vertical-align:middle; }
    .inv-tbl tbody td.ac { text-align:center; }
    .inv-tbl tbody td.ar { text-align:right; font-weight:600; }
    .inv-tbl tfoot td { padding:0.6rem; font-weight:700; font-size:0.9rem; border-top:2px solid #1b2a5e; color:#1b2a5e; background:#f7f9fc; }
    .qty-inp { width:54px; text-align:center; padding:0.25rem; border:2px solid #f4a300; border-radius:6px; font-size:0.82rem; font-weight:700; background:#fffbf0; }
    .badge-em { font-size:0.6rem; background:#fff3cd; color:#856404; border:1px solid #ffc107; border-radius:4px; padding:1px 4px; margin-left:3px; font-weight:600; }

    /* Actions */
    .inv-actions { display:flex; gap:0.5rem; flex-wrap:wrap; margin-bottom:1rem; }
    .inv-actions .abtn { padding:0.65rem 1rem; font-size:0.85rem; font-weight:700; border:none; border-radius:10px; cursor:pointer; text-decoration:none; display:inline-flex; align-items:center; gap:0.3rem; }
    .abtn-submit { background:linear-gradient(135deg,#8B6914,#A07D1A); color:#fff; }
    .abtn-pdf { background:linear-gradient(135deg,#1565c0,#1976d2); color:#fff; }
    .abtn-add { background:var(--warm-white); color:var(--ink); border:1px solid var(--border) !important; }
    .abtn-edit { background:linear-gradient(135deg,#F4A300,#E09500); color:#333; }
    .abtn-print { background:var(--warm-white); color:var(--ink); border:1px solid var(--border) !important; }

    /* Product picker panel */
    .picker-panel { display:none; background:#fff; border:1px solid var(--border); border-radius:12px; overflow:hidden; margin-bottom:1rem; max-height:350px; }
    .picker-panel.open { display:block; }
    .picker-search { width:100%; padding:0.65rem 1rem; border:none; border-bottom:1px solid var(--border); font-size:0.9rem; outline:none; }
    .picker-list { max-height:280px; overflow-y:auto; -webkit-overflow-scrolling:touch; }
    .picker-item { display:flex; align-items:center; justify-content:space-between; padding:0.65rem 1rem; border-top:1px solid var(--border); cursor:pointer; transition:background 0.1s; }
    .picker-item:first-child { border-top:none; }
    .picker-item:active { background:#fff8e1; }
    .picker-item .pname { font-weight:600; font-size:0.88rem; }
    .picker-item .padd { font-size:0.75rem; color:#1565c0; font-weight:600; }
    .picker-empty { padding:1.5rem; text-align:center; color:var(--muted); font-size:0.85rem; }

    @media print { .topbar,.sidebar,.sidebar-overlay,.inv-actions,.picker-panel,.menu-toggle{display:none!important;} .layout{display:block!important;} .content{padding:0!important;} .inv-wrap{border:none;border-radius:0;} }
  </style>

    <div class="inv-wrap">
      <div class="inv-head">
        <div class="company">FLAVIO PTY LTD</div>
        <div class="inv-label">INVOICE</div>
      </div>

      <div class="inv-meta">
        <div class="block">
          <div class="lbl">Bill To</div>
          <div class="val">Rizins Burgers <%= invoice.storeName %></div>
        </div>
        <div class="block">
          <div class="lbl">Invoice #</div>
          <div class="val"><%= invoice.id.substring(0,8).toUpperCase() %></div>
        </div>
        <div class="block">
          <div class="lbl">Date</div>
          <div class="val"><%= formatDate(invoice.invoiceDate) %></div>
        </div>
        <div class="block">
          <div class="lbl">Status</div>
          <div class="val" style="color:<%= invoice.status === 'submitted' ? '#2e7d32' : '#e65100' %>;">
            <%= invoice.status === 'submitted' ? '✓ Submitted' : '✏ Draft' %>
          </div>
        </div>
      </div>

      <% if (invoice.status === 'draft') { %>
        <div style="padding:0.4rem 1.25rem; font-size:0.72rem; color:#999; background:#fffdf7; border-bottom:1px solid #f0ead8;">💡 Tap received qty to edit</div>
      <% } %>

      <div class="inv-table-wrap">
        <table class="inv-tbl">
          <thead>
            <tr>
              <th style="width:4%;">#</th>
              <th>Description</th>
              <th class="ac" style="width:10%;">Ordered</th>
              <th class="ac" style="width:12%;">Received</th>
              <th class="ac" style="width:13%;">Price</th>
              <th class="ar" style="width:12%;">Amount</th>
            </tr>
          </thead>
          <tbody id="invoiceBody">
            <% if (invoice.items && invoice.items.length > 0) { %>
              <% var grandTotal = 0; %>
              <% invoice.items.forEach(function(item, idx) { %>
                <% var price = parseFloat(item.unit_price) || 0; %>
                <% var qty = parseFloat(item.quantity_received) || 0; %>
                <% var lineTotal = price * qty; %>
                <% grandTotal += lineTotal; %>
                <tr data-item-id="<%= item.id %>" class="<%= invoice.status === 'draft' ? 'editable' : '' %>">
                  <td><%= idx + 1 %></td>
                  <td>
                    <%= item.product_name %>
                    <% if (item.is_emergency) { %><span class="badge-em">🚨</span><% } %>
                  </td>
                  <td class="ac" style="color:#aaa;"><%= item.quantity_ordered || '—' %></td>
                  <td class="ac">
                    <% if (invoice.status === 'draft') { %>
                      <input class="qty-inp" type="text"
                             value="<%= item.quantity_received || '0' %>"
                             data-item-id="<%= item.id %>" data-price="<%= price %>"
                             onfocus="this.select()"
                             onchange="commitEdit(this)"
                             onkeydown="if(event.key==='Enter'){this.blur();}">
                    <% } else { %>
                      <strong style="color:#1b2a5e;"><%= qty > 0 ? qty : '0' %></strong>
                    <% } %>
                  </td>
                  <td class="ac">$<%= price.toFixed(2) %></td>
                  <td class="ar inv-line-total"><%= lineTotal > 0 ? lineTotal.toFixed(2) : '—' %></td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="6" style="text-align:center;color:#aaa;padding:1.5rem;">No items yet.</td></tr>
            <% } %>
          </tbody>
          <tfoot>
            <tr>
              <td colspan="5" style="text-align:right;padding-right:0.75rem;">TOTAL</td>
              <td class="ar" id="invGrandTotal">$ <%= typeof grandTotal !== 'undefined' ? grandTotal.toFixed(2) : '0.00' %></td>
            </tr>
          </tfoot>
        </table>
      </div>

      <% if (invoice.notes) { %>
        <div style="padding:0.75rem 1.25rem; font-size:0.85rem; color:#555; border-top:1px solid #eef0f6;">
          <strong style="color:#1b2a5e;">Notes:</strong> <%= invoice.notes %>
        </div>
      <% } %>
    </div>

    <!-- ── Actions ── -->
    <% if (invoice.status === 'draft') { %>
      <form method="POST" action="/manager/received-invoice/submit" id="invoiceForm">
        <input type="hidden" name="invoiceId" value="<%= invoice.id %>">
        <input type="hidden" name="generalNotes" value="">
        <% if (invoice.items) { invoice.items.forEach(function(item) { %>
          <input type="hidden" name="selected_<%= item.id %>" value="1">
          <input type="hidden" name="quantity_<%= item.id %>" class="inv-qty-hidden" data-item-id="<%= item.id %>" value="<%= item.quantity_received || '0' %>">
          <input type="hidden" name="notes_<%= item.id %>" value="<%= item.item_notes || '' %>">
        <% }); } %>
        <div class="inv-actions">
          <button type="submit" class="abtn abtn-submit">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
            Submit
          </button>
          <a href="/manager/received-invoice/download-draft?invoiceId=<%= invoice.id %>" class="abtn abtn-pdf">📥 PDF</a>
          <button type="button" class="abtn abtn-add" onclick="togglePicker()">🚨 Add Item</button>
        </div>
      </form>
    <% } else { %>
      <div class="inv-actions">
        <a href="/manager/received-invoice/download" class="abtn abtn-pdf">📥 Download PDF</a>
        <form method="POST" action="/manager/received-invoice/reopen" style="display:contents;">
          <input type="hidden" name="invoiceId" value="<%= invoice.id %>">
          <button type="submit" class="abtn abtn-edit">✏️ Edit</button>
        </form>
        <button class="abtn abtn-print" onclick="window.print()">🖨 Print</button>
      </div>
    <% } %>

    <!-- ── Product Picker Panel ── -->
    <div class="picker-panel" id="pickerPanel">
      <input type="text" class="picker-search" id="pickerSearch" placeholder="🔍 Search products..." oninput="filterPicker(this.value)">
      <div class="picker-list" id="pickerList">
        <% var products = typeof availableProducts !== 'undefined' ? availableProducts : []; %>
        <% if (products.length > 0) { %>
          <% products.forEach(function(name) { %>
            <div class="picker-item" data-name="<%= name.toLowerCase() %>" onclick="pickProduct('<%= name.replace(/'/g, "\\'") %>')">
              <span class="pname"><%= name %></span>
              <span class="padd">+ Add</span>
            </div>
          <% }); %>
        <% } else { %>
          <div class="picker-empty">All products are already on the invoice.</div>
        <% } %>
      </div>
      <!-- Also allow typing a custom name -->
      <form method="POST" action="/manager/received-invoice/add-item" style="display:flex; gap:0.4rem; padding:0.65rem 1rem; border-top:1px solid var(--border); background:#f7f9fc;">
        <input type="hidden" name="invoiceId" value="<%= invoice.id %>">
        <input type="text" name="productName" id="customProductInput" placeholder="Or type a custom item..." style="flex:1; padding:0.45rem 0.65rem; border:1px solid var(--border); border-radius:6px; font-size:0.85rem;">
        <button type="submit" style="padding:0.45rem 0.8rem; font-size:0.82rem; font-weight:700; background:linear-gradient(135deg,#f4a300,#e8950a); color:#1a1400; border:none; border-radius:6px; cursor:pointer;">Add</button>
      </form>
    </div>

  <% } %>

  <script>
    var INVOICE_ID = '<%= invoice ? invoice.id : "" %>';

    function commitEdit(input) {
      var row = input.closest('tr');
      var val = parseFloat(input.value) || 0;
      var price = parseFloat(input.dataset.price) || 0;
      var lt = val * price;
      var id = input.dataset.itemId;

      // Update line total
      var tc = row.querySelector('.inv-line-total');
      if (tc) tc.textContent = lt > 0 ? lt.toFixed(2) : '—';

      // Update hidden form
      var h = document.querySelector('.inv-qty-hidden[data-item-id="'+id+'"]');
      if (h) h.value = val;

      recalcTotal();
      schedSave(id, val);
    }

    function recalcTotal() {
      var t = 0;
      document.querySelectorAll('.inv-line-total').forEach(function(c) {
        t += parseFloat(c.textContent.replace(/[^0-9.]/g,'')) || 0;
      });
      var el = document.getElementById('invGrandTotal');
      if (el) el.textContent = '$ ' + t.toFixed(2);
    }

    var _st;
    function schedSave(id, qty) {
      clearTimeout(_st);
      _st = setTimeout(function() {
        fetch('/manager/received-invoice/update-item', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ invoiceId: INVOICE_ID, itemId: id, quantityReceived: String(qty) })
        }).catch(function(){});
      }, 500);
    }

    /* ─── Picker ─── */
    function togglePicker() {
      var p = document.getElementById('pickerPanel');
      p.classList.toggle('open');
      if (p.classList.contains('open')) {
        document.getElementById('pickerSearch').focus();
      }
    }

    function filterPicker(q) {
      var items = document.querySelectorAll('#pickerList .picker-item');
      var lower = q.toLowerCase();
      items.forEach(function(el) {
        el.style.display = el.dataset.name.includes(lower) ? '' : 'none';
      });
    }

    function pickProduct(name) {
      // Submit via form
      var inp = document.getElementById('customProductInput');
      inp.value = name;
      inp.closest('form').submit();
    }
  </script>

<%- include('../partials/footer') %>
