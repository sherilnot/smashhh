<%- include('../partials/header', { title: 'Management Report', role: 'store_manager', active: 'reports' }) %>

  <h1>Management Report</h1>
  <p style="color: var(--text-muted); margin-bottom: 1.25rem;">Send a written report with optional photos to the Operations Manager.</p>

  <% if (error) { %>
    <div class="error"><%= error %></div>
  <% } %>

  <% if (success) { %>
    <div class="msg">✅ Report submitted successfully to the Operations Manager!</div>
  <% } %>

  <div class="card" style="margin-bottom: 1.5rem;">
    <h2 style="margin-top: 0; font-size: 1.1rem;">New Report</h2>
    <form method="POST" action="/manager/reports/submit" enctype="multipart/form-data">
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <div>
          <label style="font-weight: 600; display: block; margin-bottom: 0.4rem;">Report</label>
          <textarea name="reportText" required placeholder="Describe what's happening at the store..."
                    style="width: 100%; padding: 8px; border: 1px solid var(--border); border-radius: 6px; min-height: 120px; resize: vertical;"></textarea>
        </div>

        <div>
          <label style="font-weight: 600; display: block; margin-bottom: 0.4rem;">Photos (optional, max 5 images)</label>
          <input type="file" name="photos" accept="image/*" multiple
                 style="padding: 6px;">
          <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.3rem;">
            Attach photos if helpful. Max 10MB per image.
          </div>
        </div>

        <div>
          <button type="submit" class="btn" style="background: linear-gradient(180deg, var(--green), #388E3C); color: white; padding: 10px 24px;">
            📝 Submit Report
          </button>
        </div>
      </div>
    </form>
  </div>

  <% if (reports && reports.length > 0) { %>
    <h2 style="font-size: 1.1rem;">Previous Reports</h2>
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Report</th>
          <th>Photos</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% reports.forEach(function(rep) { %>
          <tr>
            <td><%= new Date(rep.submitted_at).toLocaleString('en-AU', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) %></td>
            <td style="color: var(--text-muted); max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= rep.report_text %></td>
            <td><%= rep.image_count %> image<%= rep.image_count === 1 ? '' : 's' %></td>
            <td>
              <% if (rep.status === 'reviewed') { %>
                <span class="badge" style="background: var(--green); color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem;">REVIEWED</span>
              <% } else { %>
                <span class="badge" style="background: var(--accent); color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem;">SENT</span>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>

<%- include('../partials/footer') %>
