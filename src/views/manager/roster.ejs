<%- include('../partials/header', { title: 'Weekly Roster', role: 'store_manager', active: 'roster', wide: true, live: 'availability:submitted' }) %>

  <h1>Weekly Roster</h1>

  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <% if (typeof query !== 'undefined' && query.success === 'roster_published') { %>
    <div class="msg">✅ Roster sent! Employees can now see their shifts.</div>
  <% } %>

  <% if (!hasManagedStore) { %>
    <div class="empty">No store assigned.</div>
  <% } else { %>
    <% var editMode = (typeof query !== 'undefined' && query.edit === '1') || false; %>

    <!-- Week Navigation -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; padding: 0.6rem 0.75rem; background: var(--warm-white); border: 1px solid var(--border); border-radius: 10px;">
      <% if (canGoPrev) { %>
        <a href="/manager/roster?date=<%= prevWeekDate %><%= editMode ? '&edit=1' : '' %>" style="color: var(--lettuce-dark); font-weight: 700; text-decoration: none; font-size: 0.85rem;">←</a>
      <% } else { %>
        <span style="color: var(--muted);">←</span>
      <% } %>
      <strong style="font-size: 0.9rem; color: var(--bun-dark);"><%= formatDate(weekStartFormatted) %> — <%= formatDate(weekEndFormatted) %></strong>
      <% if (canGoNext) { %>
        <a href="/manager/roster?date=<%= nextWeekDate %><%= editMode ? '&edit=1' : '' %>" style="color: var(--lettuce-dark); font-weight: 700; text-decoration: none; font-size: 0.85rem;">→</a>
      <% } else { %>
        <span style="color: var(--muted);">→</span>
      <% } %>
    </div>

    <!-- Controls -->
    <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap;">
      <% if (!editMode) { %>
        <a href="/manager/roster?date=<%= weekStartFormatted %>&edit=1" style="padding: 0.5rem 1rem; font-size: 0.8rem; font-weight: 600; background: var(--warm-white); color: var(--ink); border: 1px solid var(--border); border-radius: 8px; text-decoration: none;">Edit</a>
        <form method="POST" action="/manager/roster/publish" style="margin: 0;">
          <input type="hidden" name="weekStart" value="<%= weekStartFormatted %>">
          <button type="submit" style="padding: 0.5rem 1rem; font-size: 0.8rem; font-weight: 700; background: linear-gradient(135deg, #2e7d32, #388e3c); color: white; border: none; border-radius: 8px; cursor: pointer;">📤 Send</button>
        </form>
      <% } else { %>
        <a href="/manager/roster?date=<%= weekStartFormatted %>" style="padding: 0.5rem 1rem; font-size: 0.8rem; font-weight: 600; background: var(--warm-white); color: var(--ink); border: 1px solid var(--border); border-radius: 8px; text-decoration: none;">Done</a>
      <% } %>
    </div>

    <!-- ═══ Availability by Day (collapsible) ═══ -->
    <% var avail = (typeof availabilityByDay !== 'undefined') ? availabilityByDay : []; %>
    <% if (avail.length > 0) { %>
      <%
        var totalAvailable = 0;
        avail.forEach(function(d) { totalAvailable += d.total; });
      %>
      <div style="margin-bottom:1rem;">
        <div style="font-size:0.72rem; font-weight:700; color:var(--muted); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:0.5rem;">
          Availability Requests (<%= totalAvailable %>)
        </div>
        <div style="display:flex; flex-direction:column; gap:0.4rem;">
          <% avail.forEach(function(day, dIdx) { %>
            <div style="background:var(--warm-white); border:1px solid var(--border); border-radius:10px; overflow:hidden;">
              <!-- Day header -->
              <div onclick="toggleDay(<%= dIdx %>)" style="display:flex; align-items:center; justify-content:space-between; padding:0.65rem 0.9rem; cursor:pointer; user-select:none;">
                <div style="display:flex; align-items:center; gap:0.6rem; flex-wrap:wrap;">
                  <span style="font-weight:700; font-size:0.9rem; color:var(--bun-dark); min-width:4.5rem;"><%= day.label %></span>
                  <span style="font-size:0.7rem; color:var(--muted);"><%= formatDateShort(day.date) %></span>
                  <% if (day.total > 0) { %>
                    <span style="font-size:0.68rem; padding:0.15rem 0.45rem; background:#1a1a2e; color:#fff; border-radius:20px; font-weight:700;"><%= day.total %> available</span>
                    <% if (day.counts.Morning > 0) { %><span style="font-size:0.65rem; padding:0.12rem 0.4rem; background:#C8E6C9; color:#1b5e20; border-radius:5px; font-weight:600;">🌅 <%= day.counts.Morning %></span><% } %>
                    <% if (day.counts.Evening > 0) { %><span style="font-size:0.65rem; padding:0.12rem 0.4rem; background:#BBDEFB; color:#0d47a1; border-radius:5px; font-weight:600;">🌆 <%= day.counts.Evening %></span><% } %>
                    <% if (day.counts['Full Day'] > 0) { %><span style="font-size:0.65rem; padding:0.12rem 0.4rem; background:#FFE0B2; color:#e65100; border-radius:5px; font-weight:600;">☀ <%= day.counts['Full Day'] %></span><% } %>
                  <% } else { %>
                    <span style="font-size:0.7rem; color:var(--muted);">No requests</span>
                  <% } %>
                </div>
                <span id="dayArrow-<%= dIdx %>" style="font-size:0.9rem; color:var(--muted); transition:transform 0.2s;">▾</span>
              </div>

              <!-- People list (collapsed by default) -->
              <div id="dayPanel-<%= dIdx %>" style="display:none; border-top:1px solid var(--border);">
                <% if (day.people.length === 0) { %>
                  <div style="padding:0.75rem 0.9rem; font-size:0.8rem; color:var(--muted);">No availability requests for this day.</div>
                <% } else { %>
                  <% day.people.forEach(function(p) { %>
                    <div style="display:flex; align-items:center; gap:0.6rem; padding:0.55rem 0.9rem; border-top:1px solid var(--border); flex-wrap:wrap;">
                      <div style="flex:1; min-width:120px;">
                        <div style="font-weight:600; font-size:0.85rem;"><%= p.name %></div>
                        <div style="font-size:0.68rem; color:var(--muted);">
                          <%= p.employmentType === 'casual' ? 'Casual' : 'Permanent' %>
                          <% if (p.priorityScore > 0) { %> · Priority <%= p.priorityScore %><% } %>
                        </div>
                      </div>
                      <span style="font-size:0.7rem; padding:0.2rem 0.5rem; background:<%= p.color %>; color:#333; border-radius:6px; font-weight:700; white-space:nowrap;">
                        <%= p.shiftLabel %>
                      </span>
                      <span style="font-size:0.68rem; color:var(--muted); white-space:nowrap;"><%= p.timeRange %></span>
                      <form method="POST" action="/manager/roster/assign" style="margin:0;">
                        <input type="hidden" name="weekStart" value="<%= weekStartFormatted %>">
                        <input type="hidden" name="employeeId" value="<%= p.employeeId %>">
                        <input type="hidden" name="shiftType" value="<%= p.shiftCode %>">
                        <input type="hidden" name="day" value="<%= day.date %>">
                        <button type="submit" style="padding:0.35rem 0.75rem; font-size:0.75rem; font-weight:700; background:linear-gradient(135deg,#2e7d32,#388e3c); color:#fff; border:none; border-radius:6px; cursor:pointer; white-space:nowrap;">
                          ✓ Assign
                        </button>
                      </form>
                    </div>
                  <% }); %>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>

    <!-- Roster Table -->
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch; border: 1px solid var(--border); border-radius: 10px;">
      <table style="width: 100%; min-width: 650px; margin: 0; border: none; box-shadow: none;">
        <thead>
          <tr>
            <th style="position: sticky; left: 0; background: linear-gradient(135deg, #fef3e2, #fdefd8); z-index: 2; min-width: 90px; font-size: 0.65rem;">EMPLOYEE</th>
            <% dayLabels.forEach(function(label, i) { %>
              <th style="text-align: center; font-size: 0.65rem; padding: 0.5rem 0.3rem;">
                <div><%= label %></div>
                <div style="font-weight: 400; color: var(--muted);"><%= formatDateShort(dayDates[i]) %></div>
              </th>
            <% }) %>
          </tr>
        </thead>
        <tbody>
          <% rosterRows.forEach(function(row) { %>
            <%
              // Check if this employee has any shifts at all
              var hasShifts = row.byDay.some(function(d) { return d.length > 0; });
              if (!hasShifts && !editMode) return; // hide empty rows in view mode
            %>
            <tr>
              <td style="position: sticky; left: 0; background: var(--warm-white); z-index: 1; padding: 0.4rem 0.5rem; border-bottom: 1px solid var(--border);">
                <div style="font-weight: 700; font-size: 0.8rem; white-space: nowrap;"><%= row.name %></div>
                <% if (row.employmentType === 'casual') { %>
                  <span style="font-size: 0.6rem; color: var(--mustard);">Casual</span>
                <% } else if (row.employmentType === 'permanent') { %>
                  <span style="font-size: 0.6rem; color: var(--green);">Perm</span>
                <% } %>
              </td>
              <% row.byDay.forEach(function(shifts_in_day, dayIdx) { %>
                <td style="text-align: center; padding: 0.3rem; vertical-align: top; border-bottom: 1px solid var(--border);">
                  <% shifts_in_day.filter(function(s) { return s.booking_status !== 'cancelled'; }).forEach(function(shift) { %>
                    <div style="padding: 0.25rem 0.2rem; border-radius: 5px; background: <%= shift.color %>; font-size: 0.7rem; border: 1px solid rgba(0,0,0,0.05); margin-bottom: 0.2rem;">
                      <div style="font-weight: 600; color: #333;"><%= shift.label %></div>
                      <% if (shift.actual_clock_in) { %>
                        <div style="color: var(--green); font-size: 0.6rem;">In: <%= shift.actual_clock_in %></div>
                      <% } %>
                      <% if (editMode) { %>
                        <form method="POST" action="/manager/roster/unassign" style="margin-top: 0.2rem;">
                          <input type="hidden" name="bookingId" value="<%= shift.booking_id %>">
                          <input type="hidden" name="weekStart" value="<%= weekStartFormatted %>">
                          <button type="submit" style="font-size: 0.6rem; padding: 0.1rem 0.3rem; background: white; color: #c62828; border: 1px solid #f3c6c6; border-radius: 3px; cursor: pointer;">✕</button>
                        </form>
                      <% } %>
                    </div>
                  <% }); %>
                  <% if (shifts_in_day.filter(function(s) { return s.booking_status !== 'cancelled'; }).length === 0) { %>
                    <span style="color: var(--muted); font-size: 0.7rem;">—</span>
                  <% } %>
                </td>
              <% }); %>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% if (editMode && employees && employees.length > 0) { %>
      <!-- Assign employee -->
      <div style="margin-top: 1rem; padding: 0.85rem; background: var(--warm-white); border: 1px solid var(--border); border-radius: 10px;">
        <div style="font-weight: 700; font-size: 0.85rem; margin-bottom: 0.5rem;">Assign Shift</div>
        <form method="POST" action="/manager/roster/assign" style="display: flex; gap: 0.4rem; flex-wrap: wrap; align-items: center;">
          <input type="hidden" name="weekStart" value="<%= weekStartFormatted %>">
          <select name="employeeId" style="flex: 1; min-width: 120px; padding: 0.4rem; border: 1px solid var(--border); border-radius: 6px; font-size: 0.8rem;">
            <% employees.forEach(function(emp) { %>
              <option value="<%= emp.id %>"><%= emp.first_name %> <%= emp.last_name || '' %></option>
            <% }) %>
          </select>
          <select name="shiftType" style="padding: 0.4rem; border: 1px solid var(--border); border-radius: 6px; font-size: 0.8rem;">
            <option value="11-1730">Morning</option>
            <option value="1730-2100">Evening</option>
            <option value="11-2100">Full Day</option>
          </select>
          <select name="day" style="padding: 0.4rem; border: 1px solid var(--border); border-radius: 6px; font-size: 0.8rem;">
            <% dayLabels.forEach(function(label, i) { %>
              <option value="<%= dayDates[i] %>"><%= label %></option>
            <% }) %>
          </select>
          <button type="submit" style="padding: 0.4rem 0.8rem; font-size: 0.8rem; font-weight: 700; background: linear-gradient(135deg, #f4a300, #e8950a); color: var(--bun-dark); border: none; border-radius: 6px; cursor: pointer;">Add</button>
        </form>
      </div>
    <% } %>

  <% } %>

  <script>
    function toggleDay(idx) {
      var panel = document.getElementById('dayPanel-' + idx);
      var arrow = document.getElementById('dayArrow-' + idx);
      if (!panel) return;
      if (panel.style.display === 'none') {
        panel.style.display = 'block';
        arrow.style.transform = 'rotate(180deg)';
      } else {
        panel.style.display = 'none';
        arrow.style.transform = 'rotate(0deg)';
      }
    }
  </script>

<%- include('../partials/footer') %>
