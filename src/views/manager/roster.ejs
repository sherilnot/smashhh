<%- include('../partials/header', { title: 'Weekly Roster', role: 'store_manager', active: 'roster', wide: true, live: 'availability:submitted,shifts:changed,roster:updated,temporary-assignment:created,temporary-assignment:cancelled' }) %>

  <h1>Weekly Roster</h1>

  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <% if (typeof query !== 'undefined' && query.success === 'roster_published') { %>
    <div class="msg"><i data-lucide="circle-check" class="ico"></i>Roster sent! Employees can now see their shifts.</div>
  <% } %>

  <% if (!hasManagedStore) { %>
    <div class="empty">No store assigned.</div>
  <% } else { %>
    <% var editMode = (typeof query !== 'undefined' && query.edit === '1') || false; %>

    <!-- Week Navigation -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; padding: 0.6rem 0.75rem; background: var(--warm-white); border: 1px solid var(--border); border-radius: 10px;">
      <% if (canGoPrev) { %>
        <a href="/manager/roster?date=<%= prevWeekDate %><%= editMode ? '&edit=1' : '' %>" style="color: var(--lettuce-dark); font-weight: 700; text-decoration: none; font-size: 0.85rem;">←</a>
      <% } else { %>
        <span style="color: var(--muted);">←</span>
      <% } %>
      <strong style="font-size: 0.9rem; color: var(--bun-dark);"><%= formatDate(weekStartFormatted) %> — <%= formatDate(weekEndFormatted) %></strong>
      <% if (canGoNext) { %>
        <a href="/manager/roster?date=<%= nextWeekDate %><%= editMode ? '&edit=1' : '' %>" style="color: var(--lettuce-dark); font-weight: 700; text-decoration: none; font-size: 0.85rem;">→</a>
      <% } else { %>
        <span style="color: var(--muted);">→</span>
      <% } %>
    </div>

    <!-- Controls -->
    <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap;">
      <% if (!editMode) { %>
        <a href="/manager/roster?date=<%= weekStartFormatted %>&edit=1" style="padding: 0.5rem 1rem; font-size: 0.8rem; font-weight: 600; background: var(--warm-white); color: var(--ink); border: 1px solid var(--border); border-radius: 8px; text-decoration: none;">Edit</a>
        <form method="POST" action="/manager/roster/publish" style="margin: 0;">
          <input type="hidden" name="weekStart" value="<%= weekStartFormatted %>">
          <button type="submit" style="padding: 0.5rem 1rem; font-size: 0.8rem; font-weight: 700; background: linear-gradient(135deg, #2e7d32, #388e3c); color: white; border: none; border-radius: 8px; cursor: pointer;"><i data-lucide="send" class="ico"></i>Send</button>
        </form>
      <% } else { %>
        <a href="/manager/roster?date=<%= weekStartFormatted %>" style="padding: 0.5rem 1rem; font-size: 0.8rem; font-weight: 600; background: var(--warm-white); color: var(--ink); border: 1px solid var(--border); border-radius: 8px; text-decoration: none;">Done</a>
      <% } %>
    </div>

    <!-- Availability is submitted for next week: point there when this week has none -->
    <% if (typeof nextWeekRequests !== 'undefined' && nextWeekRequests > 0) { %>
      <a href="/manager/roster?date=<%= nextWeekDate %><%= editMode ? '&edit=1' : '' %>"
         style="display:flex; align-items:center; justify-content:space-between; gap:0.75rem; margin-bottom:1rem; padding:0.8rem 1rem; background:#1a1a2e; color:#fff; border-radius:12px; text-decoration:none; box-shadow:var(--shadow);">
        <span style="font-size:0.9rem;"><i data-lucide="calendar-check" class="ico"></i><strong><%= nextWeekRequests %></strong> availability request<%= nextWeekRequests !== 1 ? 's' : '' %> for next week</span>
        <span style="font-weight:700; white-space:nowrap;">View →</span>
      </a>
    <% } %>

    <!-- ═══ Availability by Day (days with requests start open) ═══ -->
    <% var avail = (typeof availabilityByDay !== 'undefined') ? availabilityByDay : []; %>
    <% if (avail.length > 0) { %>
      <%
        var totalAvailable = 0;
        avail.forEach(function(d) { totalAvailable += d.total; });
      %>
      <div style="margin-bottom:1rem;">
        <div style="font-size:0.72rem; font-weight:700; color:var(--muted); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:0.5rem;">
          Availability Requests (<%= totalAvailable %>)
        </div>
        <style>
          /* Availability list: one compact row per person, one colour per shift (same as Book Shifts) */
          .av-days { display:flex; flex-direction:column; gap:0.45rem; }
          .av-card { background:var(--warm-white); border:1px solid var(--border); border-radius:12px; overflow:hidden; }
          .av-head { display:flex; align-items:center; gap:0.5rem; padding:0.7rem 0.9rem; cursor:pointer; user-select:none; }
          .av-head-day { font-weight:700; color:var(--bun-dark); width:2.6rem; }
          .av-head-date { font-size:0.75rem; color:var(--muted); flex:1; }
          .av-head-none { font-size:0.75rem; color:var(--muted); }
          .av-arrow { color:var(--muted); font-size:0.8rem; transition:transform 0.2s; margin-left:0.25rem; }
          .av-count { display:inline-flex; align-items:center; gap:0.2rem; font-size:0.72rem; font-weight:700;
                      padding:0.15rem 0.45rem; border-radius:999px; }
          .av-count .ico { width:13px; height:13px; margin:0; }
          .av-list { border-top:1px solid var(--border); }
          .av-row { display:flex; align-items:center; gap:0.6rem; padding:0.5rem 0.9rem; }
          .av-row + .av-row { border-top:1px solid #f2ede6; }
          .av-name { flex:1; min-width:0; font-weight:600; font-size:0.88rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
          .av-pill { display:inline-flex; align-items:center; gap:0.25rem; font-size:0.75rem; font-weight:600;
                     padding:0.25rem 0.55rem; border-radius:999px; white-space:nowrap; }
          .av-pill .ico { width:14px; height:14px; margin:0; }
          .av-pill small { font-weight:500; opacity:0.8; font-size:0.7rem; }
          .av-am { background:#e8f5e9; color:#2e7d32; }
          .av-pm { background:#fff3e0; color:#e65100; }
          .av-full { background:#e3f2fd; color:#1565c0; }
          .av-custom { background:#f3e5f5; color:#7b1fa2; }
          .av-off { background:#f1efec; color:#9a8f84; }
          .av-assign { width:2rem; height:2rem; flex-shrink:0; display:flex; align-items:center; justify-content:center;
                       border:none; border-radius:50%; background:#2e7d32; color:#fff; cursor:pointer; padding:0; }
          .av-assign .ico { width:16px; height:16px; margin:0; }
          .av-spacer { width:2rem; flex-shrink:0; }
        </style>
        <%
          var AV_ICON = { am: 'sunrise', pm: 'sunset', full: 'sun', custom: 'clock', off: 'x' };
          var AV_COUNT = [['Morning', 'am'], ['Evening', 'pm'], ['Full Day', 'full'], ['Custom', 'custom']];
        %>
        <div class="av-days">
          <% avail.forEach(function(day, dIdx) { %>
            <div class="av-card">
              <div class="av-head" onclick="toggleDay(<%= dIdx %>)">
                <span class="av-head-day"><%= day.label %></span>
                <span class="av-head-date"><%= formatDateShort(day.date) %></span>
                <% if (day.total > 0) { %>
                  <% AV_COUNT.forEach(function(c) { if (day.counts[c[0]] > 0) { %>
                    <span class="av-count av-<%= c[1] %>" title="<%= c[0] %>"><i data-lucide="<%= AV_ICON[c[1]] %>" class="ico"></i><%= day.counts[c[0]] %></span>
                  <% } }); %>
                <% } else if (day.people.length > 0) { %>
                  <span class="av-head-none"><%= day.people.length %> not available</span>
                <% } else { %>
                  <span class="av-head-none">No requests</span>
                <% } %>
                <span id="dayArrow-<%= dIdx %>" class="av-arrow" style="<%= day.total > 0 ? 'transform:rotate(180deg);' : '' %>">▾</span>
              </div>

              <div id="dayPanel-<%= dIdx %>" class="av-list" style="display:<%= day.total > 0 ? 'block' : 'none' %>;">
                <% if (day.people.length === 0) { %>
                  <div class="av-row" style="color:var(--muted); font-size:0.8rem;">No availability for this day.</div>
                <% } %>
                <% day.people.forEach(function(p) { %>
                  <div class="av-row">
                    <span class="av-name"><%= p.name %></span>
                    <span class="av-pill av-<%= p.cls %>">
                      <i data-lucide="<%= AV_ICON[p.cls] || 'clock' %>" class="ico"></i>
                      <% if (p.cls === 'off') { %>Off<% } else if (p.cls === 'custom') { %><%= p.shortRange %><% } else { %><%= p.shiftLabel === 'Full Day' ? 'Full day' : p.shiftLabel %> <small><%= p.shortRange %></small><% } %>
                    </span>
                    <% if (p.available !== false) { %>
                      <form method="POST" action="/manager/roster/assign" style="margin:0;">
                        <input type="hidden" name="weekStart" value="<%= weekStartFormatted %>">
                        <input type="hidden" name="employeeId" value="<%= p.employeeId %>">
                        <input type="hidden" name="shiftType" value="<%= p.shiftCode %>">
                        <input type="hidden" name="day" value="<%= day.date %>">
                        <button type="submit" class="av-assign" title="Assign <%= p.name %> to this shift" aria-label="Assign <%= p.name %>">
                          <i data-lucide="check" class="ico"></i>
                        </button>
                      </form>
                    <% } else { %>
                      <span class="av-spacer"></span>
                    <% } %>
                  </div>
                <% }); %>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>

    <!-- Roster Table -->
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch; border: 1px solid var(--border); border-radius: 10px;">
      <table style="width: 100%; min-width: 650px; margin: 0; border: none; box-shadow: none;">
        <thead>
          <tr>
            <th style="position: sticky; left: 0; background: linear-gradient(135deg, #fef3e2, #fdefd8); z-index: 2; min-width: 90px; font-size: 0.65rem;">EMPLOYEE</th>
            <% dayLabels.forEach(function(label, i) { %>
              <th style="text-align: center; font-size: 0.65rem; padding: 0.5rem 0.3rem;">
                <div><%= label %></div>
                <div style="font-weight: 400; color: var(--muted);"><%= formatDateShort(dayDates[i]) %></div>
              </th>
            <% }) %>
          </tr>
        </thead>
        <tbody>
          <% rosterRows.forEach(function(row) { %>
            <%
              // Check if this employee has any shifts at all
              var hasShifts = row.byDay.some(function(d) { return d.length > 0; });
              if (!hasShifts && !editMode) return; // hide empty rows in view mode
            %>
            <tr>
              <td style="position: sticky; left: 0; background: var(--warm-white); z-index: 1; padding: 0.4rem 0.5rem; border-bottom: 1px solid var(--border);">
                <div style="font-weight: 700; font-size: 0.8rem; white-space: nowrap;"><%= row.name %></div>
                <% if (row.employmentType === 'casual') { %>
                  <span style="font-size: 0.6rem; color: var(--mustard);">Casual</span>
                <% } else if (row.employmentType === 'permanent') { %>
                  <span style="font-size: 0.6rem; color: var(--green);">Perm</span>
                <% } %>
              </td>
              <% row.byDay.forEach(function(shifts_in_day, dayIdx) { %>
                <td style="text-align: center; padding: 0.3rem; vertical-align: top; border-bottom: 1px solid var(--border);">
                  <% shifts_in_day.filter(function(s) { return s.booking_status !== 'cancelled'; }).forEach(function(shift) { %>
                    <div style="padding: 0.25rem 0.2rem; border-radius: 5px; background: <%= shift.color %>; font-size: 0.7rem; border: 1px solid rgba(0,0,0,0.05); margin-bottom: 0.2rem;">
                      <div style="font-weight: 600; color: #333;"><%= shift.label %></div>
                      <% if (shift.is_temporary_assignment && shift.from_store_name) { %>
                        <div style="font-size: 0.55rem; color: #ff9800; font-weight: 600; background: #fff3e0; padding: 0.1rem 0.2rem; border-radius: 3px; margin: 0.1rem 0;" title="Temporary from <%= shift.from_store_name %>">
                          <i data-lucide="arrow-down-left" class="ico"></i>From <%= shift.from_store_name %>
                        </div>
                      <% } %>
                      <% if (shift.actual_clock_in) { %>
                        <div style="color: var(--green); font-size: 0.6rem;">In: <%= shift.actual_clock_in %></div>
                      <% } %>
                      <% if (editMode) { %>
                        <form method="POST" action="/manager/roster/unassign" style="margin-top: 0.2rem;">
                          <input type="hidden" name="bookingId" value="<%= shift.booking_id %>">
                          <input type="hidden" name="weekStart" value="<%= weekStartFormatted %>">
                          <button type="submit" style="font-size: 0.6rem; padding: 0.1rem 0.3rem; background: white; color: #c62828; border: 1px solid #f3c6c6; border-radius: 3px; cursor: pointer;"><i data-lucide="x" class="ico"></i></button>
                        </form>
                      <% } %>
                    </div>
                  <% }); %>
                  <% if (shifts_in_day.filter(function(s) { return s.booking_status !== 'cancelled'; }).length === 0) { %>
                    <span style="color: var(--muted); font-size: 0.7rem;">—</span>
                  <% } %>
                </td>
              <% }); %>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% if (editMode && employees && employees.length > 0) { %>
      <!-- Assign employee -->
      <div style="margin-top: 1rem; padding: 0.85rem; background: var(--warm-white); border: 1px solid var(--border); border-radius: 10px;">
        <div style="font-weight: 700; font-size: 0.85rem; margin-bottom: 0.5rem;">Assign Shift</div>
        <form method="POST" action="/manager/roster/assign" style="display: flex; gap: 0.4rem; flex-wrap: wrap; align-items: center;">
          <input type="hidden" name="weekStart" value="<%= weekStartFormatted %>">
          <select name="employeeId" style="flex: 1; min-width: 120px; padding: 0.4rem; border: 1px solid var(--border); border-radius: 6px; font-size: 0.8rem;">
            <% employees.forEach(function(emp) { %>
              <option value="<%= emp.id %>"><%= emp.first_name %> <%= emp.last_name || '' %></option>
            <% }) %>
          </select>
          <select name="shiftType" style="padding: 0.4rem; border: 1px solid var(--border); border-radius: 6px; font-size: 0.8rem;">
            <option value="11-1730">Morning</option>
            <option value="1730-2100">Evening</option>
            <option value="11-2100">Full Day</option>
          </select>
          <select name="day" style="padding: 0.4rem; border: 1px solid var(--border); border-radius: 6px; font-size: 0.8rem;">
            <% dayLabels.forEach(function(label, i) { %>
              <option value="<%= dayDates[i] %>"><%= label %></option>
            <% }) %>
          </select>
          <button type="submit" style="padding: 0.4rem 0.8rem; font-size: 0.8rem; font-weight: 700; background: linear-gradient(135deg, #f4a300, #e8950a); color: var(--bun-dark); border: none; border-radius: 6px; cursor: pointer;">Add</button>
        </form>
      </div>
    <% } %>

  <% } %>

  <script>
    function toggleDay(idx) {
      var panel = document.getElementById('dayPanel-' + idx);
      var arrow = document.getElementById('dayArrow-' + idx);
      if (!panel) return;
      if (panel.style.display === 'none') {
        panel.style.display = 'block';
        arrow.style.transform = 'rotate(180deg)';
      } else {
        panel.style.display = 'none';
        arrow.style.transform = 'rotate(0deg)';
      }
    }
  </script>

<%- include('../partials/footer') %>
