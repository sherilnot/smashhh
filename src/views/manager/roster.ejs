<%- include('../partials/header', { title: 'Weekly Roster', role: 'store_manager', active: 'roster', wide: true }) %>

  <h1>Weekly Roster</h1>

  <% if (error) { %>
    <div class="error"><%= error %></div>
  <% } %>

  <% if (typeof query !== 'undefined' && query.success === 'roster_published') { %>
    <div class="msg" style="background: linear-gradient(135deg, #e8f5e9, #c8e6c9); color: #2e7d32; padding: 0.75rem 1rem; border-radius: 8px; margin-bottom: 1rem; font-weight: 600;">
      ✅ Roster sent! Employees can now see their shifts in "My Roster".
    </div>
  <% } %>

  <% if (!hasManagedStore) { %>
    <div class="empty">You are not assigned to any store. Contact an administrator.</div>
  <% } else { %>
    <% var editMode = (typeof query !== 'undefined' && query.edit === '1') || false; %>

    <!-- Week Navigation -->
    <div class="summary" style="justify-content: space-between; gap: 1rem;">
      <% if (canGoPrev) { %>
        <a href="/manager/roster?date=<%= prevWeekDate %><%= editMode ? '&edit=1' : '' %>" style="color: var(--lettuce-dark); font-weight: 700; text-decoration: none;">← Previous</a>
      <% } else { %>
        <span style="color: var(--muted);">← Previous</span>
      <% } %>

      <div style="text-align: center;">
        <strong style="font-size: 1.1rem; color: var(--bun-dark);"><%= formatDate(weekStartFormatted) %> — <%= formatDate(weekEndFormatted) %></strong>
      </div>

      <% if (canGoNext) { %>
        <a href="/manager/roster?date=<%= nextWeekDate %><%= editMode ? '&edit=1' : '' %>" style="color: var(--lettuce-dark); font-weight: 700; text-decoration: none;">Next →</a>
      <% } else { %>
        <span style="color: var(--muted);">Next →</span>
      <% } %>
    </div>

    <!-- Controls -->
    <div style="margin-bottom: 1rem; display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
      <% if (!editMode) { %>
        <a href="/manager/roster?date=<%= weekStartFormatted %>&edit=1" class="btn" style="padding: 0.5rem 1.25rem; font-size: 0.9rem;">Edit Roster</a>
        <form method="POST" action="/manager/roster/publish" style="display: inline;">
          <input type="hidden" name="weekStart" value="<%= weekStartFormatted %>">
          <button type="submit" class="btn" style="padding: 0.5rem 1.25rem; font-size: 0.9rem; background: linear-gradient(135deg, #2e7d32, #388e3c); color: white; border: none;">📤 Send Roster</button>
        </form>
      <% } else { %>
        <a href="/manager/roster?date=<%= weekStartFormatted %>" class="btn" style="padding: 0.5rem 1.25rem; font-size: 0.9rem; background: var(--muted);">Done Editing</a>
      <% } %>
      
      <% 
        // Check if this is next week and we're approaching Sunday deadline
        var now = new Date();
        var currentDay = now.getDay(); // 0=Sun, 1=Mon, ..., 6=Sat
        var weekStartDate = new Date(weekStartFormatted);
        var isNextWeek = weekStartDate > now;
        var daysTillSunday = currentDay === 0 ? 0 : (7 - currentDay);
        var showDeadlineWarning = isNextWeek && currentDay >= 5; // Friday, Saturday, or Sunday
      %>
      
      <% if (showDeadlineWarning) { %>
        <span class="badge" style="background: linear-gradient(135deg, #fff3cd, #ffeaa7); color: #856404; padding: 0.5rem 1rem; font-size: 0.85rem; font-weight: 600; border: 1px solid rgba(255, 193, 7, 0.3);">
          <% if (currentDay === 0) { %>
            DEADLINE TODAY - Confirm roster by end of Sunday
          <% } else if (currentDay === 6) { %>
            DEADLINE TOMORROW - Confirm by Sunday
          <% } else { %>
            DEADLINE: Confirm by Sunday
          <% } %>
        </span>
      <% } %>
    </div>

    <!-- Roster Grid: employees as rows, days as columns -->
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
    <table style="width: 100%; min-width: 700px;">
      <thead>
        <tr>
          <th style="width: 14%; position: sticky; left: 0; background: linear-gradient(135deg, #fef3e2, #fdefd8); z-index: 2;">Employee</th>
          <th style="width: 7%;">Type</th>
          <% dayLabels.forEach(function(label, i) { %>
            <th><%= label %><br><span style="font-weight: 400; font-size: 0.8em; color: var(--muted);"><%= formatDateShort(dayDates[i]) %></span></th>
          <% }) %>
        </tr>
      </thead>
      <tbody>
        <% rosterRows.forEach(function(row) { %>
          <tr>
            <td style="position: sticky; left: 0; background: var(--warm-white); z-index: 1;"><strong><%= row.name %></strong></td>
            <td>
              <% if (row.employmentType === 'permanent') { %>
                <span class="badge" style="background: linear-gradient(135deg, #e0f2e9, #d3ecdf); color: var(--green); border-color: rgba(45,156,90,0.2);">Perm</span>
              <% } else if (row.employmentType === 'casual') { %>
                <span class="badge" style="background: linear-gradient(135deg, #fef3e2, #fdefd8); color: var(--mustard); border-color: rgba(244,163,0,0.2);">Casual</span>
              <% } else { %>
                <span style="color: var(--muted);">—</span>
              <% } %>
            </td>
            <% row.byDay.forEach(function(shifts_in_day, dayIdx) { %>
              <td style="vertical-align: top; padding: 0.35rem;">
                <% if (shifts_in_day.length > 0) { %>
                  <% shifts_in_day.filter(function(s) { return s.booking_status !== 'cancelled'; }).forEach(function(shift) { %>
                    <div style="margin-bottom: 0.25rem; padding: 0.3rem 0.4rem; border-radius: 4px; background: <%= shift.color %>; font-size: 0.8em; border: 1px solid rgba(0,0,0,0.08);">
                      <div style="font-weight: 600; color: #333;"><%= shift.label %></div>
                      <% if (shift.actual_clock_in) { %>
                        <div style="font-size: 0.85em; color: var(--green); margin-top: 0.15rem;">Clocked: <%= shift.actual_clock_in %></div>
                      <% } %>
                      <% if (editMode) { %>
                        <form method="POST" action="/manager/roster/unassign" style="margin-top: 0.25rem;">
                          <input type="hidden" name="bookingId" value="<%= shift.booking_id %>">
                          <input type="hidden" name="weekStart" value="<%= weekStartFormatted %>">
                          <button type="submit" class="btn-sm" style="background: #fff; color: #333; border: 1px solid #ddd; font-size: 0.7em; padding: 0.15rem 0.4rem;">Remove</button>
                        </form>
                      <% } %>
                    </div>
                  <% }) %>
                <% } else { %>
                  <span style="color: var(--muted); font-size: 0.8em;">—</span>
                <% } %>
              </td>
            <% }) %>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>

    <% if (editMode && employees && employees.length > 0) { %>
      <!-- Assign employee to shift -->
      <div class="card" style="margin-top: 1.5rem; padding: 1rem;">
        <h3 style="margin: 0 0 0.75rem 0; font-size: 1rem;">Assign Employee to Shift</h3>
        <form method="POST" action="/manager/roster/assign" style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
          <input type="hidden" name="weekStart" value="<%= weekStartFormatted %>">
          <select name="employeeId" style="padding: 0.4rem; border: 1px solid var(--line); border-radius: 4px;">
            <% employees.forEach(function(emp) { %>
              <option value="<%= emp.id %>"><%= emp.first_name %> <%= emp.last_name || '' %> (★ <%= parseFloat(emp.priority_score || 0).toFixed(0) %>)</option>
            <% }) %>
          </select>
          <select name="shiftType" style="padding: 0.4rem; border: 1px solid var(--line); border-radius: 4px;">
            <option value="11-1730">11:00 – 5:30</option>
            <option value="1730-2100">5:30 – 9:00</option>
            <option value="11-2100">11:00 – 9:00</option>
          </select>
          <select name="day" style="padding: 0.4rem; border: 1px solid var(--line); border-radius: 4px;">
            <% dayLabels.forEach(function(label, i) { %>
              <option value="<%= dayDates[i] %>"><%= label %> (<%= formatDateShort(dayDates[i]) %>)</option>
            <% }) %>
          </select>
          <button type="submit" class="btn" style="padding: 0.4rem 1rem; font-size: 0.85rem;">Assign</button>
        </form>
      </div>
    <% } %>
  <% } %>

<%- include('../partials/footer') %>
