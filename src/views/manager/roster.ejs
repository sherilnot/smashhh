<%- include('../partials/header', { title: 'Weekly Roster', role: 'store_manager', active: 'roster', wide: true }) %>

  <h1>Weekly Roster</h1>

  <% if (error) { %>
    <div class="error"><%= error %></div>
  <% } %>

  <% if (!hasManagedStore) { %>
    <div class="empty">You are not assigned to any store. Contact an administrator.</div>
  <% } else { %>
    <% var editMode = (typeof query !== 'undefined' && query.edit === '1') || false; %>

    <!-- Week Navigation -->
    <div class="summary" style="justify-content: space-between; gap: 1rem;">
      <% if (canGoPrev) { %>
        <a href="/manager/roster?date=<%= prevWeekDate %><%= editMode ? '&edit=1' : '' %>" style="color: var(--lettuce-dark); font-weight: 700; text-decoration: none;">← Previous</a>
      <% } else { %>
        <span style="color: var(--muted);">← Previous</span>
      <% } %>

      <div style="text-align: center;">
        <strong style="font-size: 1.1rem; color: var(--bun-dark);"><%= weekStartFormatted %> — <%= weekEndFormatted %></strong>
      </div>

      <% if (canGoNext) { %>
        <a href="/manager/roster?date=<%= nextWeekDate %><%= editMode ? '&edit=1' : '' %>" style="color: var(--lettuce-dark); font-weight: 700; text-decoration: none;">Next →</a>
      <% } else { %>
        <span style="color: var(--muted);">Next →</span>
      <% } %>
    </div>

    <!-- Controls -->
    <div style="margin-bottom: 1rem; display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
      <% if (!editMode) { %>
        <a href="/manager/roster?date=<%= weekStartFormatted %>&edit=1" class="btn" style="padding: 0.5rem 1.25rem; font-size: 0.9rem;">✎ Edit Roster</a>
      <% } else { %>
        <a href="/manager/roster?date=<%= weekStartFormatted %>" class="btn" style="padding: 0.5rem 1.25rem; font-size: 0.9rem; background: var(--muted);">✓ Done Editing</a>
      <% } %>
      <form method="POST" action="/manager/roster/auto-fill" style="display: inline;">
        <input type="hidden" name="weekStart" value="<%= weekStartFormatted %>">
        <button type="submit" class="btn" style="padding: 0.5rem 1.25rem; font-size: 0.9rem; background: var(--lettuce); color: var(--bun-dark);">⚡ Auto-fill</button>
      </form>
    </div>

    <!-- Roster Grid: shift types as rows, days as columns -->
    <table style="width: 100%;">
      <thead>
        <tr>
          <th style="width: 12%;">Shift</th>
          <% dayLabels.forEach(function(label, i) { %>
            <th><%= label %><br><span style="font-weight: 400; font-size: 0.8em; color: var(--muted);"><%= dayDates[i].slice(5) %></span></th>
          <% }) %>
        </tr>
      </thead>
      <tbody>
        <% rosterGrid.forEach(function(row) { %>
          <tr>
            <td style="background: <%= row.color %>; font-weight: 600;"><strong><%= row.label %></strong></td>
            <% row.byDay.forEach(function(employees_in_slot, dayIdx) { %>
              <td style="vertical-align: top; padding: 0.5rem; background: <%= row.color %>;">
                <% if (employees_in_slot.length > 0) { %>
                  <% employees_in_slot.forEach(function(emp) { %>
                    <div style="margin-bottom: 0.3rem; font-size: 0.85em;">
                      <span><%= emp.name %></span>
                      <% if (emp.timeStr) { %>
                        <span style="font-size: 0.75em; color: var(--muted); display: block;">(<%= emp.timeStr %>)</span>
                      <% } %>
                      <% if (emp.actual_clock_in) { %>
                        <span style="font-size: 0.75em; color: var(--green);">(in: <%= emp.actual_clock_in %>)</span>
                      <% } %>
                      <% if (editMode) { %>
                        <form method="POST" action="/manager/roster/unassign" style="display: inline;">
                          <input type="hidden" name="bookingId" value="<%= emp.booking_id %>">
                          <input type="hidden" name="weekStart" value="<%= weekStartFormatted %>">
                          <button type="submit" class="btn-sm" style="background: var(--tomato); color: #fff; margin-left: 0.2rem;">✗</button>
                        </form>
                      <% } %>
                    </div>
                  <% }) %>
                <% } else { %>
                  <span style="color: var(--muted); font-size: 0.8em;">—</span>
                <% } %>
              </td>
            <% }) %>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <% if (editMode && employees && employees.length > 0) { %>
      <!-- Assign employee to shift -->
      <div class="card" style="margin-top: 1.5rem; padding: 1rem;">
        <h3 style="margin: 0 0 0.75rem 0; font-size: 1rem;">Assign Employee to Shift</h3>
        <form method="POST" action="/manager/roster/assign" style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
          <input type="hidden" name="weekStart" value="<%= weekStartFormatted %>">
          <select name="employeeId" style="padding: 0.4rem; border: 1px solid var(--line); border-radius: 4px;">
            <% employees.forEach(function(emp) { %>
              <option value="<%= emp.id %>"><%= emp.last_name %>, <%= emp.first_name %> (★ <%= emp.priority_score.toFixed(0) %>)</option>
            <% }) %>
          </select>
          <select name="shiftType" style="padding: 0.4rem; border: 1px solid var(--line); border-radius: 4px;">
            <option value="11-1730">11:00 – 5:30</option>
            <option value="1730-2100">5:30 – 9:00</option>
            <option value="11-2100">11:00 – 9:00</option>
          </select>
          <select name="day" style="padding: 0.4rem; border: 1px solid var(--line); border-radius: 4px;">
            <% dayLabels.forEach(function(label, i) { %>
              <option value="<%= dayDates[i] %>"><%= label %> (<%= dayDates[i].slice(5) %>)</option>
            <% }) %>
          </select>
          <button type="submit" class="btn" style="padding: 0.4rem 1rem; font-size: 0.85rem;">+ Assign</button>
        </form>
      </div>
    <% } %>
  <% } %>

<%- include('../partials/footer') %>
