<%- include('../partials/header', { title: 'Daily Checklist', role: 'store_manager', active: 'checklist' }) %>

  <h1>Daily Checklist</h1>

  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <% if (success) { %><div class="msg">✅ Checklist submitted to warehouse!</div><% } %>

  <% if (!checklist) { %>
    <div class="empty">Unable to load checklist.</div>
  <% } else { %>

    <%
      var isEditable = checklist.editable;
      var isSubmitted = checklist.status === 'submitted' || checklist.status === 'reviewed';

      // Split items
      var activeItems = [];
      var inactiveItems = [];
      checklist.items.forEach(function(item) {
        if (item.quantity_to_bring && item.quantity_to_bring !== '0' && item.quantity_to_bring.trim() !== '') {
          activeItems.push(item);
        } else {
          inactiveItems.push(item);
        }
      });
    %>

    <!-- Banner -->
    <div style="background:var(--cream); border:1px solid var(--border); border-radius:12px; padding:0.75rem 1rem; margin-bottom:1rem; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
      <div>
        <span style="font-weight:700; color:var(--bun-dark);"><%= checklist.dateLabel %></span>
        <span style="color:var(--muted); font-size:0.85rem;"> · <%= checklist.storeName %></span>
        <div style="font-size:0.72rem; color:var(--muted); margin-top:0.15rem;"><%= formatDate(checklist.checkDate) %></div>
      </div>
      <% if (checklist.status === 'reviewed') { %>
        <span style="font-size:0.72rem; padding:0.25rem 0.6rem; background:#e8f5e9; color:#2e7d32; border-radius:8px; font-weight:700;">✓ Reviewed</span>
      <% } else if (isSubmitted) { %>
        <span style="font-size:0.72rem; padding:0.25rem 0.6rem; background:#e8f5e9; color:#2e7d32; border-radius:8px; font-weight:700;">✓ Submitted</span>
      <% } else if (isEditable) { %>
        <span style="font-size:0.72rem; padding:0.25rem 0.6rem; background:#fef3e2; color:var(--bun-dark); border-radius:8px; font-weight:700;">✏ Editing</span>
      <% } else { %>
        <span style="font-size:0.72rem; padding:0.25rem 0.6rem; background:#fce4ec; color:#c62828; border-radius:8px; font-weight:700;">🔒 Locked</span>
      <% } %>
    </div>

    <!-- ═══ Active items (have quantity) ═══ -->
    <% if (activeItems.length > 0) { %>
    <div style="background:#fff; border:1px solid var(--border); border-radius:12px; overflow:hidden; margin-bottom:1rem;">
      <% activeItems.forEach(function(item, idx) { %>
        <div class="cl-row" data-id="<%= item.id %>"
             style="display:flex; align-items:center; padding:0.7rem 1rem; border-top:<%= idx > 0 ? '1px solid var(--border)' : 'none' %>; gap:0.75rem;">
          <span style="width:1.5rem; font-size:0.8rem; color:var(--muted); font-weight:600;"><%= idx + 1 %></span>
          <span style="flex:1; font-weight:600; font-size:0.9rem;"><%= item.product_name %></span>
          <% if (isEditable) { %>
            <input type="text" class="qty-input" data-item-id="<%= item.id %>"
                   value="<%= item.quantity_to_bring %>"
                   onfocus="this.select()"
                   onchange="saveQty(this)"
                   onkeydown="if(event.key==='Enter')this.blur()"
                   style="width:52px; text-align:center; padding:0.35rem; border:2px solid var(--mustard,#f4a300); border-radius:8px; font-size:0.9rem; font-weight:700; background:#fffbf0;">
          <% } else { %>
            <span style="min-width:40px; text-align:center; padding:0.3rem 0.6rem; background:#fef3e2; border-radius:8px; font-size:0.88rem; font-weight:700; color:var(--bun-dark);"><%= item.quantity_to_bring %></span>
          <% } %>
        </div>
      <% }); %>
    </div>
    <% } else { %>
      <div class="empty" style="margin-bottom:1rem;">No items added yet. Tap "Add Items" below.</div>
    <% } %>

    <!-- ═══ Add Items Button ═══ -->
    <% if (isEditable && inactiveItems.length > 0) { %>
    <button type="button" onclick="togglePanel()"
            style="width:100%; padding:0.75rem; font-size:0.9rem; font-weight:700; background:var(--warm-white); color:var(--ink); border:1px solid var(--border); border-radius:12px; cursor:pointer; margin-bottom:0.75rem; display:flex; align-items:center; justify-content:center; gap:0.4rem;"
            id="addBtn">
      <span id="addIcon">＋</span> Add Items (<%= inactiveItems.length %>)
    </button>

    <div id="addPanel" style="display:none; background:#fff; border:1px solid var(--border); border-radius:12px; overflow:hidden; margin-bottom:1rem;">
      <div style="padding:0.5rem 1rem; background:#f7f9fc; font-size:0.72rem; font-weight:700; color:var(--muted); text-transform:uppercase; border-bottom:1px solid var(--border);">
        Select items to add
      </div>
      <div style="max-height:300px; overflow-y:auto;">
        <% inactiveItems.forEach(function(item) { %>
          <label style="display:flex; align-items:center; gap:0.75rem; padding:0.6rem 1rem; border-top:1px solid var(--border); cursor:pointer;">
            <input type="checkbox" class="add-cb" data-id="<%= item.id %>" data-needed="<%= item.quantity_needed || '1' %>"
                   style="width:20px; height:20px; accent-color:var(--mustard); flex-shrink:0;">
            <span style="flex:1; font-weight:600; font-size:0.88rem;"><%= item.product_name %></span>
            <span style="font-size:0.72rem; color:var(--muted);"><%= item.quantity_needed || '' %></span>
          </label>
        <% }); %>
      </div>
      <div style="padding:0.7rem 1rem; border-top:1px solid var(--border); background:#f7f9fc;">
        <button type="button" onclick="addSelected()"
                style="width:100%; padding:0.7rem; font-size:0.9rem; font-weight:700; background:linear-gradient(135deg,#f4a300,#e8950a); color:#1a1400; border:none; border-radius:10px; cursor:pointer;">
          ✓ Add Selected
        </button>
      </div>
    </div>
    <% } %>

    <!-- ═══ Submit ═══ -->
    <% if (isEditable) { %>
    <form method="POST" action="/manager/store-checklist/submit" id="clForm">
      <input type="hidden" name="checklistId" value="<%= checklist.id %>">
      <% checklist.items.forEach(function(item) { %>
        <input type="hidden" name="qty_<%= item.id %>" class="hid-qty" data-item-id="<%= item.id %>" value="<%= item.quantity_to_bring || '' %>">
      <% }); %>
      <button type="submit" style="width:100%; padding:0.85rem; font-size:0.95rem; font-weight:700; background:linear-gradient(135deg,#8B6914,#A07D1A); color:white; border:none; border-radius:12px; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:0.5rem;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        <%= isSubmitted ? 'Re-submit' : 'Submit to Warehouse' %>
      </button>
    </form>
    <% } %>

    <% if (!isEditable && !isSubmitted) { %>
      <div class="info">⏰ This checklist is locked (past 10am cutoff). New checklist opens at noon.</div>
    <% } %>

  <% } %>

  <script>
    var CL_ID = '<%= checklist ? checklist.id : "" %>';

    function togglePanel() {
      var p = document.getElementById('addPanel');
      var i = document.getElementById('addIcon');
      p.style.display = p.style.display === 'none' ? 'block' : 'none';
      i.textContent = p.style.display === 'none' ? '＋' : '−';
    }

    function addSelected() {
      var cbs = document.querySelectorAll('.add-cb:checked');
      if (cbs.length === 0) return;
      cbs.forEach(function(cb) {
        var h = document.querySelector('.hid-qty[data-item-id="' + cb.dataset.id + '"]');
        if (h) h.value = cb.dataset.needed === '—' ? '1' : cb.dataset.needed;
      });
      doSave(function() { location.reload(); });
    }

    function saveQty(input) {
      var id = input.dataset.itemId;
      var h = document.querySelector('.hid-qty[data-item-id="' + id + '"]');
      if (h) h.value = input.value.trim();
      doSave();
    }

    var _t;
    function doSave(cb) {
      clearTimeout(_t);
      var data = { checklistId: CL_ID };
      document.querySelectorAll('.hid-qty').forEach(function(h) {
        data['qty_' + h.dataset.itemId] = h.value;
      });
      // Also grab inline inputs
      document.querySelectorAll('.qty-input').forEach(function(inp) {
        data['qty_' + inp.dataset.itemId] = inp.value.trim();
      });
      fetch('/manager/store-checklist/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      }).then(function() { if (cb) cb(); }).catch(function() { if (cb) cb(); });
    }
  </script>

<%- include('../partials/footer') %>
