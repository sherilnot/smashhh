<%- include('../partials/header', { title: 'Timesheet', role: 'store_manager', active: 'timesheet', wide: true }) %>

  <h1>Timesheet</h1>

  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <% if (query && query.success === 'submitted') { %><div class="msg">✓ Timesheet submitted as draft.</div><% } %>
  <% if (query && query.success === 'confirmed') { %><div class="msg">✓ Timesheet confirmed and locked!</div><% } %>

  <% if (!hasStore) { %>
    <div class="empty">No store assigned.</div>
  <% } else { %>
    <% var editMode = canEdit && ((typeof query !== 'undefined' && query.edit === '1') || false); %>

    <!-- Week Navigation -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; padding: 0.6rem 0.75rem; background: var(--warm-white); border: 1px solid var(--border); border-radius: 10px;">
      <% if (canGoPrev) { %>
        <a href="/manager/timesheet?date=<%= prevWeekDate %>" style="color: var(--lettuce-dark); font-weight: 700; text-decoration: none; font-size: 0.85rem;">←</a>
      <% } else { %>
        <span style="color: var(--muted);">←</span>
      <% } %>
      <strong style="font-size: 0.9rem; color: var(--bun-dark);"><%= formatDate(weekStartFormatted) %> — <%= formatDate(weekEndFormatted) %></strong>
      <% if (canGoNext) { %>
        <a href="/manager/timesheet?date=<%= nextWeekDate %>" style="color: var(--lettuce-dark); font-weight: 700; text-decoration: none; font-size: 0.85rem;">→</a>
      <% } else { %>
        <span style="color: var(--muted);">→</span>
      <% } %>
    </div>

    <% if (isConfirmed) { %>
      <div style="padding: 0.5rem 0.75rem; background: #e8f5e9; border-radius: 8px; margin-bottom: 0.75rem; font-size: 0.8rem; color: #1b5e20; font-weight: 600;">✓ Confirmed & locked</div>
    <% } else if (isSubmitted) { %>
      <div style="padding: 0.5rem 0.75rem; background: #fff3e0; border-radius: 8px; margin-bottom: 0.75rem; font-size: 0.8rem; color: #e65100; font-weight: 600;">Draft — can still edit</div>
    <% } %>

    <% if (timesheetRows && timesheetRows.length > 0) { %>

      <%
        // Helper to convert time label to 24h format for input[type=time]
        function to24h(label) {
          if (!label) return '';
          // If already in HH:MM format (no AM/PM), return as-is
          if (/^\d{2}:\d{2}$/.test(label)) return label;
          // Parse "05:30 pm" or "11:00 am" format
          var match = label.match(/(\d{1,2}):(\d{2})\s*(am|pm|AM|PM)/i);
          if (!match) return label;
          var h = parseInt(match[1]);
          var m = match[2];
          var ampm = match[3].toLowerCase();
          if (ampm === 'pm' && h !== 12) h += 12;
          if (ampm === 'am' && h === 12) h = 0;
          return String(h).padStart(2, '0') + ':' + m;
        }
      %>

      <!-- Table with horizontal scroll -->
      <div style="overflow-x: auto; -webkit-overflow-scrolling: touch; border: 1px solid var(--border); border-radius: 10px;">
        <table style="width: 100%; min-width: 650px; margin: 0; border: none; box-shadow: none;">
          <thead>
            <tr>
              <th style="position: sticky; left: 0; background: linear-gradient(135deg, #fef3e2, #fdefd8); z-index: 2; min-width: 90px; font-size: 0.65rem;">EMPLOYEE</th>
              <% dayLabels.forEach(function(label, i) { %>
                <th style="text-align: center; font-size: 0.65rem; padding: 0.5rem 0.3rem;">
                  <div><%= label %></div>
                  <div style="font-weight: 400; color: var(--muted);"><%= formatDateShort(dayDates[i]) %></div>
                </th>
              <% }) %>
              <th style="text-align: right; font-size: 0.65rem; min-width: 50px;">TOTAL</th>
            </tr>
          </thead>
          <tbody>
            <% timesheetRows.forEach(function(row) { %>
              <tr>
                <td style="position: sticky; left: 0; background: var(--warm-white); z-index: 1; padding: 0.4rem 0.5rem; border-bottom: 1px solid var(--border);">
                  <div style="font-weight: 700; font-size: 0.8rem; white-space: nowrap;"><%= row.name %></div>
                  <% if (row.employmentType === 'casual') { %>
                    <span style="font-size: 0.6rem; color: var(--mustard);">Casual</span>
                  <% } else if (row.employmentType === 'permanent') { %>
                    <span style="font-size: 0.6rem; color: var(--green);">Perm</span>
                  <% } %>
                </td>
                <% row.byDay.forEach(function(cell) { %>
                  <td style="text-align: center; padding: 0.3rem; vertical-align: top; border-bottom: 1px solid var(--border);">
                    <% if (cell) { %>
                      <div style="padding: 0.25rem 0.2rem; border-radius: 5px; background: <%= cell.color %>; font-size: 0.7rem; border: 1px solid rgba(0,0,0,0.05);">
                        <% if (editMode && !cell.no_show) { %>
                          <form method="POST" action="/manager/timesheet/edit" style="margin: 0;">
                            <input type="hidden" name="bookingId" value="<%= cell.booking_id %>">
                            <input type="hidden" name="action" value="adjust_times">
                            <input type="hidden" name="weekStart" value="<%= weekStartFormatted %>">
                            <input type="time" name="startTime" value="<%= to24h(cell.startLabel) %>" style="width: 100%; padding: 0.15rem; border: 1px solid var(--border); border-radius: 3px; font-size: 0.65rem; margin-bottom: 0.15rem;">
                            <input type="time" name="endTime" value="<%= to24h(cell.endLabel) %>" style="width: 100%; padding: 0.15rem; border: 1px solid var(--border); border-radius: 3px; font-size: 0.65rem; margin-bottom: 0.15rem;">
                            <button type="submit" style="width: 100%; font-size: 0.6rem; padding: 0.15rem; background: #e8f5e9; color: #2e7d32; border: 1px solid #c8e6c9; border-radius: 3px; cursor: pointer; font-weight: 600; margin-bottom: 0.15rem;">Save</button>
                          </form>
                          <form method="POST" action="/manager/timesheet/edit" style="margin: 0;">
                            <input type="hidden" name="bookingId" value="<%= cell.booking_id %>">
                            <input type="hidden" name="action" value="delete_entry">
                            <input type="hidden" name="weekStart" value="<%= weekStartFormatted %>">
                            <button type="submit" style="width: 100%; font-size: 0.6rem; padding: 0.15rem; background: #fce4ec; color: #c62828; border: 1px solid #f3c6c6; border-radius: 3px; cursor: pointer;">No-show</button>
                          </form>
                        <% } else if (cell.no_show) { %>
                          <div style="color: #c62828; font-weight: 700; font-size: 0.65rem;">NO SHOW</div>
                          <% if (editMode) { %>
                            <form method="POST" action="/manager/timesheet/edit" style="margin: 0.2rem 0 0;">
                              <input type="hidden" name="bookingId" value="<%= cell.booking_id %>">
                              <input type="hidden" name="action" value="undo_no_show">
                              <input type="hidden" name="weekStart" value="<%= weekStartFormatted %>">
                              <button type="submit" style="width: 100%; font-size: 0.55rem; padding: 0.1rem; background: #e8f5e9; color: #2e7d32; border: 1px solid #c8e6c9; border-radius: 3px; cursor: pointer;">Undo</button>
                            </form>
                          <% } %>
                        <% } else { %>
                          <div style="font-weight: 600; color: #333;"><%= cell.startLabel %></div>
                          <div style="color: #555;"><%= cell.endLabel %></div>
                          <div style="font-weight: 700; color: var(--green); margin-top: 0.1rem;"><%= cell.hours_worked.toFixed(1) %>h</div>
                        <% } %>
                      </div>
                    <% } else { %>
                      <span style="color: var(--muted); font-size: 0.7rem;">—</span>
                    <% } %>
                  </td>
                <% }); %>
                <td style="text-align: right; padding: 0.4rem 0.5rem; font-weight: 800; font-size: 0.9rem; border-bottom: 1px solid var(--border); color: var(--green);">
                  <%= row.totalHours.toFixed(1) %>
                </td>
              </tr>
            <% }); %>
          </tbody>
          <tfoot>
            <tr>
              <td style="position: sticky; left: 0; background: linear-gradient(135deg, #fef3e2, #fdefd8); z-index: 1; font-weight: 700; font-size: 0.75rem; padding: 0.5rem;">
                TOTAL (<%= timesheet.employeeCount %>)
              </td>
              <% dayLabels.forEach(function() { %><td></td><% }) %>
              <td style="text-align: right; font-weight: 800; font-size: 1rem; padding: 0.5rem; color: var(--bun-dark);">
                <%= timesheet.totalHours.toFixed(1) %>h
              </td>
            </tr>
          </tfoot>
        </table>
      </div>

      <!-- Actions -->
      <% if (canEdit && !isConfirmed) { %>
        <div style="margin-top: 1rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
          <% if (!editMode) { %>
            <a href="/manager/timesheet?date=<%= weekStartFormatted %>&edit=1" style="flex: 1; padding: 0.7rem; text-align: center; font-size: 0.85rem; font-weight: 600; background: var(--warm-white); color: var(--ink); border: 1px solid var(--border); border-radius: 10px; text-decoration: none;">Edit</a>
          <% } else { %>
            <a href="/manager/timesheet?date=<%= weekStartFormatted %>" style="flex: 1; padding: 0.7rem; text-align: center; font-size: 0.85rem; font-weight: 600; background: var(--warm-white); color: var(--ink); border: 1px solid var(--border); border-radius: 10px; text-decoration: none;">Done</a>
          <% } %>
          <form method="POST" action="/manager/timesheet/submit" style="flex: 1;">
            <input type="hidden" name="weekStart" value="<%= weekStartFormatted %>">
            <input type="hidden" name="weekEnd" value="<%= weekEndFormatted %>">
            <button type="submit" style="width: 100%; padding: 0.7rem; font-size: 0.85rem; font-weight: 700; background: linear-gradient(135deg, #f4a300, #e8950a); color: var(--bun-dark); border: none; border-radius: 10px; cursor: pointer;">
              <%= isSubmitted ? 'Update' : 'Submit' %>
            </button>
          </form>
          <% if (isSubmitted) { %>
            <form method="POST" action="/manager/timesheet/confirm" style="flex: 1;" onsubmit="return confirm('Confirm and lock? Cannot undo.');">
              <input type="hidden" name="weekStart" value="<%= weekStartFormatted %>">
              <button type="submit" style="width: 100%; padding: 0.7rem; font-size: 0.85rem; font-weight: 700; background: linear-gradient(135deg, #2e7d32, #388e3c); color: white; border: none; border-radius: 10px; cursor: pointer;">
                Confirm
              </button>
            </form>
          <% } %>
        </div>
      <% } else if (isFutureWeek) { %>
        <div style="margin-top: 1rem; padding: 0.75rem; background: #f5f5f5; border-radius: 10px; color: var(--muted); font-size: 0.85rem;">
          Cannot submit timesheet for a future week.
        </div>
      <% } %>

    <% } else { %>
      <div class="empty">No completed shifts for this week.</div>
    <% } %>
  <% } %>

<%- include('../partials/footer') %>
