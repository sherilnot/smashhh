<%- include('../partials/header', { title: 'Weekly Timesheet', role: 'store_manager', active: 'timesheet', wide: true }) %>

  <h1>Weekly Timesheet</h1>

  <% if (error) { %>
    <div class="error"><%= error %></div>
  <% } %>

  <% if (success) { %>
    <div class="msg">Timesheet submitted successfully!</div>
  <% } %>

  <% if (!hasStore) { %>
    <div class="empty">You are not assigned to any store. Contact an administrator.</div>
  <% } else { %>
    <!-- Week Navigation -->
    <div class="summary" style="justify-content: space-between; gap: 1rem;">
      <% if (canGoPrev) { %>
        <a href="/manager/timesheet?date=<%= prevWeekDate %>" style="color: var(--lettuce-dark); font-weight: 700; text-decoration: none;">← Previous</a>
      <% } else { %>
        <span style="color: var(--muted);">← Previous</span>
      <% } %>

      <div style="text-align: center;">
        <strong style="font-size: 1.1rem; color: var(--bun-dark);"><%= weekStartFormatted %> — <%= weekEndFormatted %></strong>
      </div>

      <% if (canGoNext) { %>
        <a href="/manager/timesheet?date=<%= nextWeekDate %>" style="color: var(--lettuce-dark); font-weight: 700; text-decoration: none;">Next →</a>
      <% } else { %>
        <span style="color: var(--muted);">Next →</span>
      <% } %>
    </div>

    <% if (timesheetRows && timesheetRows.length > 0) { %>

      <% var editMode = (typeof query !== 'undefined' && query.edit === '1') || false; %>

      <% if (!timesheet.alreadySubmitted && !isFutureWeek) { %>
        <div style="margin-bottom: 1rem; display: flex; gap: 0.75rem; align-items: center;">
          <% if (!editMode) { %>
            <a href="/manager/timesheet?date=<%= weekStartFormatted %>&edit=1" class="btn" style="padding: 0.5rem 1.25rem; font-size: 0.9rem;">✎ Edit Timesheet</a>
          <% } else { %>
            <a href="/manager/timesheet?date=<%= weekStartFormatted %>" class="btn" style="padding: 0.5rem 1.25rem; font-size: 0.9rem; background: var(--muted);">✓ Done Editing</a>
          <% } %>
        </div>
      <% } %>

      <table style="table-layout: fixed; width: 100%;">
        <colgroup>
          <col style="width: 14%;">
          <col style="width: 7%;">
          <% dayLabels.forEach(function() { %><col style="width: 9%;"><% }) %>
          <col style="width: 7%;">
          <col style="width: 7%;">
          <col style="width: 7%;">
        </colgroup>
        <thead>
          <tr>
            <th>Employee</th>
            <th>Type</th>
            <% dayLabels.forEach(function(label, i) { %>
              <th><%= label %><br><span style="font-weight: 400; font-size: 0.8em; color: var(--muted);"><%= dayDates[i].slice(5) %></span></th>
            <% }) %>
            <th class="amount">Weekday</th>
            <th class="amount">Weekend</th>
            <th class="amount">Total</th>
          </tr>
        </thead>
        <tbody>
          <% timesheetRows.forEach(function(row) { %>
            <tr>
              <td><strong><%= row.name %></strong></td>
              <td>
                <% if (row.employmentType === 'permanent') { %>
                  <span class="badge" style="background: linear-gradient(135deg, #e0f2e9, #d3ecdf); color: var(--green); border-color: rgba(45,156,90,0.2);">Permanent</span>
                <% } else if (row.employmentType === 'casual') { %>
                  <span class="badge" style="background: linear-gradient(135deg, #fef3e2, #fdefd8); color: var(--mustard); border-color: rgba(244,163,0,0.2);">Casual</span>
                <% } else { %>
                  <span style="color: var(--muted);">—</span>
                <% } %>
              </td>
              <% row.byDay.forEach(function(cell) { %>
                <td style="vertical-align: top; padding: 0.35rem;">
                  <% if (cell) { %>
                    <% if (editMode) { %>
                      <% if (cell.no_show) { %>
                        <div style="padding: 0.3rem 0.4rem; border-radius: 4px; background: #EEEEEE; font-size: 0.8em; border: 1px solid rgba(0,0,0,0.08); text-decoration: line-through; opacity: 0.6;">
                          <div style="color: var(--muted);"><%= cell.label %></div>
                        </div>
                        <form method="POST" action="/manager/timesheet/edit" style="margin-top: 0.25rem;">
                          <input type="hidden" name="bookingId" value="<%= cell.booking_id %>">
                          <input type="hidden" name="action" value="delete_entry">
                          <input type="hidden" name="weekStart" value="<%= weekStartFormatted %>">
                          <button type="submit" class="btn-sm" style="background: var(--lettuce); color: var(--bun-dark); font-size: 0.7em; padding: 0.15rem 0.4rem;">↩ Undo</button>
                        </form>
                      <% } else { %>
                        <div style="padding: 0.3rem 0.4rem; border-radius: 4px; background: <%= cell.color %>; font-size: 0.8em; border: 1px solid rgba(0,0,0,0.08);">
                          <div style="font-weight: 600; color: #333;"><%= cell.label %></div>
                          <div style="display:flex; gap: 0.2rem; align-items: center; margin-top: 0.25rem;">
                            <form method="POST" action="/manager/timesheet/edit" style="display:flex; gap: 0.2rem; align-items: center; flex: 1;">
                              <input type="hidden" name="bookingId" value="<%= cell.booking_id %>">
                              <input type="hidden" name="action" value="adjust_hours">
                              <input type="hidden" name="weekStart" value="<%= weekStartFormatted %>">
                              <input type="number" name="adjustedHours" step="0.25" min="0" max="24"
                                     style="width: 3rem; padding: 0.2rem 0.3rem; border: 1px solid var(--line); border-radius: 3px; font-size: 0.75em;"
                                     value="<%= cell.hours_worked.toFixed(2) %>">
                              <button type="submit" class="btn-sm" style="background: var(--mustard); color: var(--bun-dark); font-size: 0.7em; padding: 0.15rem 0.3rem;">✓</button>
                            </form>
                          </div>
                          <form method="POST" action="/manager/timesheet/edit" style="margin-top: 0.2rem;">
                            <input type="hidden" name="bookingId" value="<%= cell.booking_id %>">
                            <input type="hidden" name="action" value="delete_entry">
                            <input type="hidden" name="weekStart" value="<%= weekStartFormatted %>">
                            <button type="submit" class="btn-sm" style="background: var(--tomato); color: #fff; font-size: 0.7em; padding: 0.15rem 0.4rem;">🗑 Del</button>
                          </form>
                        </div>
                      <% } %>
                    <% } else { %>
                      <div style="padding: 0.3rem 0.4rem; border-radius: 4px; background: <%= cell.color %>; font-size: 0.8em; border: 1px solid rgba(0,0,0,0.08);">
                        <div style="font-weight: 600; color: #333;"><%= cell.label %></div>
                        <% if (cell.adjusted) { %>
                          <div style="font-size: 0.85em; color: var(--mustard); margin-top: 0.15rem;">✎ <%= cell.hours_worked.toFixed(2) %>h</div>
                        <% } else { %>
                          <div style="font-size: 0.85em; color: #666; margin-top: 0.15rem;"><%= cell.hours_worked.toFixed(2) %>h</div>
                        <% } %>
                      </div>
                    <% } %>
                  <% } else { %>
                    <span style="color: var(--muted); font-size: 0.8em;">—</span>
                  <% } %>
                </td>
              <% }) %>
              <td class="amount"><%= row.weekdayHours.toFixed(2) %></td>
              <td class="amount"><%= row.weekendHours.toFixed(2) %></td>
              <td class="amount"><strong><%= row.totalHours.toFixed(2) %></strong></td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="2"><strong>Total (<%= timesheet.employeeCount %> employees)</strong></td>
            <% dayLabels.forEach(function() { %><td></td><% }) %>
            <td></td>
            <td></td>
            <td class="amount"><strong><%= timesheet.totalHours.toFixed(2) %></strong></td>
          </tr>
        </tfoot>
      </table>

      <% if (!timesheet.alreadySubmitted && !isFutureWeek) { %>
        <form method="POST" action="/manager/timesheet/submit" style="margin-top: 1.25rem;">
          <input type="hidden" name="weekStart" value="<%= weekStartFormatted %>">
          <input type="hidden" name="weekEnd" value="<%= weekEndFormatted %>">
          <button type="submit" class="btn" style="padding: 0.75rem 2rem; font-size: 1rem;">📤 Submit Timesheet</button>
        </form>
      <% } else if (timesheet.alreadySubmitted) { %>
        <div class="msg" style="margin-top: 1rem;">✓ This timesheet has already been submitted.</div>
      <% } else { %>
        <div class="info" style="margin-top: 1rem;">Cannot submit timesheet for a future week.</div>
      <% } %>
    <% } else { %>
      <div class="empty">No completed shifts for this week.</div>
    <% } %>
  <% } %>

<%- include('../partials/footer') %>
