<%- include('../partials/header', { title: 'Cash Reports', role: 'operation_manager', active: 'cash' }) %>

  <h1>Cash Reports</h1>
  <p style="color: var(--text-muted); margin-bottom: 1.25rem;">Photos of liquid cash submitted by shop managers.</p>

  <% if (submissions.length === 0) { %>
    <div class="empty">No cash reports have been submitted yet.</div>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Store</th>
          <th>Submitted By</th>
          <th class="amount">Amount</th>
          <th>Photos</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% submissions.forEach(function(sub) { %>
          <tr>
            <td><%= new Date(sub.submitted_at).toLocaleString('en-AU', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) %></td>
            <td><strong><%= sub.store_name %></strong></td>
            <td><%= sub.first_name %> <%= sub.last_name %></td>
            <td class="amount" style="font-weight: 600;">$<%= parseFloat(sub.amount).toFixed(2) %></td>
            <td><%= sub.image_count %> image<%= parseInt(sub.image_count) > 1 ? 's' : '' %></td>
            <td>
              <% if (sub.status === 'reviewed') { %>
                <span class="badge" style="background: var(--green); color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem;">REVIEWED</span>
              <% } else { %>
                <span class="badge" style="background: var(--accent); color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem;">NEW</span>
              <% } %>
            </td>
            <td><a href="/operation-manager/cash/<%= sub.id %>" class="btn" style="padding: 4px 12px; font-size: 0.8rem;">View</a></td>
          </tr>
        <% }); %>
      </tbody>
    </table>

    <% if (totalPages > 1) { %>
      <div style="margin-top: 1.25rem; display: flex; gap: 8px; justify-content: center;">
        <% if (page > 1) { %>
          <a href="?page=<%= page - 1 %>" class="btn" style="padding: 4px 12px;">&laquo; Prev</a>
        <% } %>
        <span style="padding: 6px 12px; color: var(--text-muted);">Page <%= page %> of <%= totalPages %></span>
        <% if (page < totalPages) { %>
          <a href="?page=<%= page + 1 %>" class="btn" style="padding: 4px 12px;">Next &raquo;</a>
        <% } %>
      </div>
    <% } %>
  <% } %>

<%- include('../partials/footer') %>
