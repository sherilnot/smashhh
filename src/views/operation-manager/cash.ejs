<%- include('../partials/header', { title: 'Cash Reports', role: 'operation_manager', active: 'cash' }) %>

  <h1>Cash Reports by Store</h1>

  <% var storeNames = Object.keys(byStore); %>
  <% if (storeNames.length === 0) { %>
    <div class="empty">No cash reports submitted yet.</div>
  <% } else { %>

    <p style="font-size:0.8rem; color:var(--muted); margin-bottom:1rem;"><%= total %> report<%= total !== 1 ? 's' : '' %> total · Tap a store to expand</p>

    <div style="display:flex; flex-direction:column; gap:0.6rem;">
      <% storeNames.forEach(function(storeName, storeIdx) { %>
        <% var subs = byStore[storeName]; %>
        <%
          var storeTotal = 0;
          subs.forEach(function(s) { storeTotal += parseFloat(s.amount) || 0; });
        %>
        <div style="background:var(--warm-white); border:1px solid var(--border); border-radius:12px; overflow:hidden; box-shadow:var(--shadow);">
          <div onclick="toggleStore('<%= storeIdx %>')" style="display:flex; align-items:center; justify-content:space-between; padding:0.85rem 1.1rem; cursor:pointer; user-select:none;">
            <div>
              <span style="font-weight:700; font-size:1rem; color:var(--bun-dark);"><%= storeName %></span>
              <span style="font-size:0.78rem; color:var(--muted); margin-left:0.5rem;">(<%= subs.length %>)</span>
            </div>
            <div style="display:flex; align-items:center; gap:0.75rem;">
              <span style="font-weight:700; font-size:0.92rem; color:var(--bun-dark);">$<%= storeTotal.toFixed(2) %></span>
              <span id="arrow-<%= storeIdx %>" style="font-size:1.1rem; color:var(--muted); transition:transform 0.2s;">▸</span>
            </div>
          </div>

          <div id="store-<%= storeIdx %>" style="display:none; border-top:1px solid var(--border);">
            <% subs.forEach(function(sub) { %>
              <a href="/operation-manager/cash/<%= sub.id %>"
                 style="display:flex; align-items:center; gap:0.75rem; padding:0.65rem 1.1rem; text-decoration:none; color:var(--ink); border-top:1px solid var(--border);">
                <div style="flex:1; min-width:0;">
                  <div style="font-weight:600; font-size:0.9rem;">$<%= parseFloat(sub.amount).toFixed(2) %></div>
                  <div style="font-size:0.73rem; color:var(--muted);">
                    <%= formatDateTime(sub.submitted_at) %> · <%= sub.first_name %> <%= sub.last_name %> · 📷 <%= sub.image_count %>
                  </div>
                </div>
                <% if (sub.status === 'reviewed') { %>
                  <span style="font-size:0.63rem; padding:0.15rem 0.4rem; background:#e8f5e9; color:#2e7d32; border-radius:6px; font-weight:600;">REVIEWED</span>
                <% } else { %>
                  <span style="font-size:0.63rem; padding:0.15rem 0.4rem; background:#fef3e2; color:var(--bun-dark); border-radius:6px; font-weight:600;">NEW</span>
                <% } %>
                <span style="color:var(--muted); font-size:0.9rem;">›</span>
              </a>
            <% }); %>
          </div>
        </div>
      <% }); %>
    </div>

  <% } %>

  <script>
    function toggleStore(idx) {
      var panel = document.getElementById('store-' + idx);
      var arrow = document.getElementById('arrow-' + idx);
      if (panel.style.display === 'none') {
        panel.style.display = 'block';
        arrow.style.transform = 'rotate(90deg)';
      } else {
        panel.style.display = 'none';
        arrow.style.transform = 'rotate(0deg)';
      }
    }
  </script>

<%- include('../partials/footer') %>
