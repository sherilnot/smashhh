<%- include('../partials/header', { title: 'Operations Dashboard', role: 'operation_manager', active: 'dashboard' }) %>

  <h1>Operations</h1>

  <!-- Stats -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.75rem; margin-bottom: 1.5rem;">
    <a href="/operation-manager/invoices" style="background: linear-gradient(135deg, #1a1a1a, #2a1507); border-radius: 14px; padding: 1.1rem; color: white; text-decoration: none; display: block;">
      <div style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px; color: rgba(255,255,255,0.6); margin-bottom: 0.3rem;">Invoices</div>
      <div style="font-size: 1.3rem; font-weight: 800; color: #f4a300;">View →</div>
    </a>
    <a href="/operation-manager/cash" style="background: linear-gradient(135deg, #1a1a1a, #2a1507); border-radius: 14px; padding: 1.1rem; color: white; text-decoration: none; display: block;">
      <div style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px; color: rgba(255,255,255,0.6); margin-bottom: 0.3rem;">Cash Reports</div>
      <div style="font-size: 1.3rem; font-weight: 800; color: #81c784;">View →</div>
    </a>
    <a href="/operation-manager/maintenance" style="background: linear-gradient(135deg, #1a1a1a, #2a1507); border-radius: 14px; padding: 1.1rem; color: white; text-decoration: none; display: block;">
      <div style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px; color: rgba(255,255,255,0.6); margin-bottom: 0.3rem;">Maintenance</div>
      <div style="font-size: 1.3rem; font-weight: 800; color: #ff7043;">View →</div>
    </a>
  </div>

  <!-- Quick Nav -->
  <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.6rem;">
    <a href="/operation-manager/invoices" style="display: flex; flex-direction: column; align-items: center; gap: 0.4rem; padding: 1rem; background: var(--warm-white); border: 1px solid var(--border); border-radius: 12px; text-decoration: none; color: var(--ink);">
      <span style="font-size: 1.8rem;">🧾</span>
      <span style="font-weight: 600; font-size: 0.8rem;">Invoices</span>
    </a>
    <a href="/operation-manager/cash" style="display: flex; flex-direction: column; align-items: center; gap: 0.4rem; padding: 1rem; background: var(--warm-white); border: 1px solid var(--border); border-radius: 12px; text-decoration: none; color: var(--ink);">
      <span style="font-size: 1.8rem;">💰</span>
      <span style="font-weight: 600; font-size: 0.8rem;">Cash</span>
    </a>
    <a href="/operation-manager/maintenance" style="display: flex; flex-direction: column; align-items: center; gap: 0.4rem; padding: 1rem; background: var(--warm-white); border: 1px solid var(--border); border-radius: 12px; text-decoration: none; color: var(--ink);">
      <span style="font-size: 1.8rem;">🔧</span>
      <span style="font-weight: 600; font-size: 0.8rem;">Maintenance</span>
    </a>
  </div>

<%- include('../partials/footer') %>
