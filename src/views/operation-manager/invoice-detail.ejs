<%- include('../partials/header', { title: 'Invoice Detail', role: 'operation_manager', active: 'invoices' }) %>

  <h1>Invoice Detail</h1>

  <% if (error) { %>
    <div class="error"><%= error %></div>
  <% } %>

  <% if (!invoice) { %>
    <div class="empty">Invoice not found.</div>
  <% } else { %>
    <div class="card" style="margin-bottom: 1.25rem;">
      <div style="display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
        <div>
          <strong><%= invoice.store_name %></strong>
        </div>
        <div style="color: var(--text-muted); font-size: 0.85rem;">
          <%= new Date(invoice.invoice_date).toLocaleDateString('en-AU', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
        </div>
      </div>
      <div style="margin-top: 0.5rem; color: var(--text-muted); font-size: 0.85rem;">
        Submitted by: <strong><%= invoice.first_name %> <%= invoice.last_name %></strong>
        <% if (invoice.submitted_at) { %>
          &nbsp;at&nbsp;<%= new Date(invoice.submitted_at).toLocaleString('en-AU', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) %>
        <% } %>
      </div>
    </div>

    <div style="overflow-x: auto;">
      <table>
        <thead>
          <tr>
            <th style="width: 4%;">#</th>
            <th style="width: 25%;">Product</th>
            <th style="width: 12%;">Ordered</th>
            <th style="width: 12%;">Received</th>
            <th style="width: 10%;">Unit Price</th>
            <th style="width: 12%;">Total</th>
            <th style="width: 25%;">Notes</th>
          </tr>
        </thead>
        <tbody>
          <% if (invoice.items && invoice.items.length > 0) { %>
            <% var grandTotal = 0; %>
            <% var displayIdx = 0; %>
            <% invoice.items.forEach(function(item, idx) { %>
              <% var price = parseFloat(item.unit_price) || 0; %>
              <% var qty = parseFloat(item.quantity_received) || 0; %>
              <% var lineTotal = price * qty; %>
              <% if (item.item_notes === 'NOT SELECTED' || qty === 0) { return; } %>
              <% grandTotal += lineTotal; %>
              <% displayIdx++; %>
              <% var mismatch = item.quantity_ordered && item.quantity_received && item.quantity_ordered !== item.quantity_received; %>
              <tr style="<%= mismatch ? 'background: #FFF3E0;' : '' %>">
                <td><%= displayIdx %></td>
                <td><strong><%= item.product_name %></strong></td>
                <td style="text-align: center; color: var(--text-muted);"><%= item.quantity_ordered || '-' %></td>
                <td style="text-align: center; font-weight: 600;">
                  <%= item.quantity_received || '-' %>
                  <% if (mismatch) { %>
                    <span style="color: #E65100; font-size: 0.75rem; display: block;">⚠ differs</span>
                  <% } %>
                </td>
                <td style="text-align: center;">$<%= price.toFixed(2) %></td>
                <td style="text-align: center; font-weight: 600;">$<%= lineTotal.toFixed(2) %></td>
                <td style="color: var(--text-muted); font-size: 0.85rem;"><%= item.item_notes || '-' %></td>
              </tr>
            <% }); %>
            <tr style="background: var(--surface-alt); font-weight: 700;">
              <td colspan="5" style="text-align: right;">Grand Total:</td>
              <td style="text-align: center;">$<%= grandTotal.toFixed(2) %></td>
              <td></td>
            </tr>
          <% } else { %>
            <tr><td colspan="7" class="empty">No items in this invoice.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <% if (invoice.notes) { %>
      <div class="card" style="margin-top: 1.25rem;">
        <strong>Manager Notes:</strong> <%= invoice.notes %>
      </div>
    <% } %>

    <div style="margin-top: 1.5rem; display: flex; gap: 10px;">
      <a href="/operation-manager/invoices" class="btn" style="padding: 6px 16px;">&larr; Back to Invoices</a>
      <a href="/operation-manager/invoices/<%= invoice.id %>/download" class="btn" style="padding: 6px 16px; background: linear-gradient(180deg, var(--green), #388E3C); color: white;">⬇ Download CSV</a>
    </div>
  <% } %>

<%- include('../partials/footer') %>
