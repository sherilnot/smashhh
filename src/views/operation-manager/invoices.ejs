<%- include('../partials/header', { title: 'Received Invoices', role: 'operation_manager', active: 'invoices' }) %>

  <h1>Received Invoices</h1>
  <p style="color: var(--text-muted); margin-bottom: 1.25rem;">Daily invoices submitted by shop managers after receiving deliveries from the warehouse.</p>

  <% if (invoices.length === 0) { %>
    <div class="empty">No invoices have been submitted yet.</div>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Store</th>
          <th>Submitted By</th>
          <th>Submitted At</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% invoices.forEach(function(inv) { %>
          <tr>
            <td><%= formatDate(inv.invoice_date) %></td>
            <td><strong><%= inv.store_name %></strong></td>
            <td><%= inv.first_name %> <%= inv.last_name %></td>
            <td><%= inv.submitted_at ? formatDateTime(inv.submitted_at) : '-' %></td>
            <td><a href="/operation-manager/invoices/<%= inv.id %>" class="btn" style="padding: 4px 12px; font-size: 0.8rem;">View</a></td>
          </tr>
        <% }); %>
      </tbody>
    </table>

    <% if (totalPages > 1) { %>
      <div style="margin-top: 1.25rem; display: flex; gap: 8px; justify-content: center;">
        <% if (page > 1) { %>
          <a href="?page=<%= page - 1 %>" class="btn" style="padding: 4px 12px;">&laquo; Prev</a>
        <% } %>
        <span style="padding: 6px 12px; color: var(--text-muted);">Page <%= page %> of <%= totalPages %></span>
        <% if (page < totalPages) { %>
          <a href="?page=<%= page + 1 %>" class="btn" style="padding: 4px 12px;">Next &raquo;</a>
        <% } %>
      </div>
    <% } %>
  <% } %>

<%- include('../partials/footer') %>
