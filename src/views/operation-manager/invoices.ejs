<%- include('../partials/header', { title: 'Invoices', role: 'operation_manager', active: 'invoices' }) %>

  <h1>Invoices</h1>

  <% if (invoices.length === 0) { %>
    <div class="empty">No invoices submitted yet.</div>
  <% } else { %>
    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
      <% invoices.forEach(function(inv) { %>
        <a href="/operation-manager/invoices/<%= inv.id %>" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; background: var(--warm-white); border: 1px solid var(--border); border-radius: 12px; text-decoration: none; color: var(--ink); box-shadow: var(--shadow);">
          <div style="flex: 1; min-width: 0;">
            <div style="font-weight: 700; font-size: 0.95rem;"><%= inv.store_name %></div>
            <div style="font-size: 0.8rem; color: var(--muted); margin-top: 0.15rem;">
              <%= formatDate(inv.invoice_date) %> · <%= inv.first_name %> <%= inv.last_name %>
            </div>
          </div>
          <div style="font-size: 0.75rem; color: var(--muted); text-align: right; flex-shrink: 0;">
            <%= inv.submitted_at ? formatDateShort(inv.submitted_at) : '' %>
          </div>
          <span style="color: var(--muted); font-size: 1rem;">›</span>
        </a>
      <% }); %>
    </div>

    <% if (totalPages > 1) { %>
      <div style="margin-top: 1.25rem; display: flex; gap: 8px; justify-content: center;">
        <% if (page > 1) { %>
          <a href="?page=<%= page - 1 %>" style="padding: 0.4rem 1rem; background: var(--warm-white); border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: var(--ink); font-size: 0.85rem;">← Prev</a>
        <% } %>
        <span style="padding: 0.4rem 0.75rem; color: var(--muted); font-size: 0.85rem;">Page <%= page %>/<%= totalPages %></span>
        <% if (page < totalPages) { %>
          <a href="?page=<%= page + 1 %>" style="padding: 0.4rem 1rem; background: var(--warm-white); border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: var(--ink); font-size: 0.85rem;">Next →</a>
        <% } %>
      </div>
    <% } %>
  <% } %>

<%- include('../partials/footer') %>
