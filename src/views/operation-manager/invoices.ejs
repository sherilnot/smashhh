<%- include('../partials/header', { title: 'Invoices', role: 'operation_manager', active: 'invoices', live: 'invoice:submitted' }) %>

  <h1>Invoices by Store</h1>

  <% var storeNames = Object.keys(byStore); %>
  <% if (storeNames.length === 0) { %>
    <div class="empty">No invoices submitted yet.</div>
  <% } else { %>

    <p style="font-size:0.8rem; color:var(--muted); margin-bottom:1rem;"><%= total %> invoice<%= total !== 1 ? 's' : '' %> total · Tap a store to expand</p>

    <div style="display:flex; flex-direction:column; gap:0.6rem;">
      <% storeNames.forEach(function(storeName, storeIdx) { %>
        <% var invoices = byStore[storeName]; %>
        <div style="background:var(--warm-white); border:1px solid var(--border); border-radius:12px; overflow:hidden; box-shadow:var(--shadow);">
          <!-- Store header (clickable) -->
          <div onclick="toggleStore('<%= storeIdx %>')" style="display:flex; align-items:center; justify-content:space-between; padding:0.85rem 1.1rem; cursor:pointer; user-select:none;">
            <div>
              <span style="font-weight:700; font-size:1rem; color:var(--bun-dark);"><%= storeName %></span>
              <span style="font-size:0.78rem; color:var(--muted); margin-left:0.5rem;">(<%= invoices.length %> invoice<%= invoices.length !== 1 ? 's' : '' %>)</span>
            </div>
            <span id="arrow-<%= storeIdx %>" style="font-size:1.1rem; color:var(--muted); transition:transform 0.2s;">▸</span>
          </div>

          <!-- Per-store exports -->
          <div style="display:flex; gap:0.4rem; flex-wrap:wrap; align-items:center; padding:0.5rem 1.1rem 0.7rem; border-top:1px solid var(--border); background:#f7f9fc;">
            <span style="font-size:0.68rem; font-weight:700; color:var(--muted); text-transform:uppercase; margin-right:0.2rem;">PDF Folder:</span>
            <a href="/operation-manager/invoices-export?store=<%= encodeURIComponent(storeName) %>&period=week"
               title="ZIP containing one PDF per invoice for this week"
               style="padding:0.35rem 0.7rem; font-size:0.74rem; font-weight:700; background:linear-gradient(135deg,#1d6f42,#217346); color:#fff; border-radius:6px; text-decoration:none;">
              🗂 This Week
            </a>
            <a href="/operation-manager/invoices-export?store=<%= encodeURIComponent(storeName) %>&period=month"
               title="ZIP containing one PDF per invoice for this month"
               style="padding:0.35rem 0.7rem; font-size:0.74rem; font-weight:700; background:linear-gradient(135deg,#1f4e79,#2e75b6); color:#fff; border-radius:6px; text-decoration:none;">
              🗂 This Month
            </a>
            <span style="width:1px; height:18px; background:var(--border); margin:0 0.15rem;"></span>
            <a href="/operation-manager/invoices-export?store=<%= encodeURIComponent(storeName) %>&period=month&format=csv"
               title="Spreadsheet of this month's figures"
               style="padding:0.35rem 0.6rem; font-size:0.72rem; font-weight:600; background:var(--warm-white); color:var(--ink); border:1px solid var(--border); border-radius:6px; text-decoration:none;">
              Spreadsheet
            </a>
          </div>

          <!-- Invoice list (collapsed by default) -->
          <div id="store-<%= storeIdx %>" style="display:none; border-top:1px solid var(--border);">
            <% invoices.forEach(function(inv) { %>
              <a href="/operation-manager/invoices/<%= inv.id %>"
                 style="display:flex; align-items:center; gap:0.75rem; padding:0.65rem 1.1rem; text-decoration:none; color:var(--ink); border-top:1px solid var(--border);">
                <div style="flex:1; min-width:0;">
                  <div style="font-weight:600; font-size:0.88rem;"><%= formatDate(inv.invoice_date) %></div>
                  <div style="font-size:0.75rem; color:var(--muted);"><%= inv.first_name %> <%= inv.last_name %></div>
                </div>
                <div style="font-size:0.72rem; color:var(--muted); text-align:right; flex-shrink:0;">
                  <% if (inv.submitted_at) { %>
                    <%= formatDateShort(inv.submitted_at) %>
                  <% } %>
                </div>
                <span style="color:var(--muted); font-size:0.9rem;">›</span>
              </a>
            <% }); %>
          </div>
        </div>
      <% }); %>
    </div>

  <% } %>

  <script>
    function toggleStore(idx) {
      var panel = document.getElementById('store-' + idx);
      var arrow = document.getElementById('arrow-' + idx);
      if (panel.style.display === 'none') {
        panel.style.display = 'block';
        arrow.style.transform = 'rotate(90deg)';
      } else {
        panel.style.display = 'none';
        arrow.style.transform = 'rotate(0deg)';
      }
    }
  </script>

<%- include('../partials/footer') %>
