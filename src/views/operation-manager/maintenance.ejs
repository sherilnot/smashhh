<%- include('../partials/header', { title: 'Maintenance Reports', role: 'operation_manager', active: 'maintenance' }) %>

  <h1>Maintenance Reports</h1>
  <p style="color: var(--text-muted); margin-bottom: 1.25rem;">Maintenance issues reported by shop managers.</p>

  <% if (reports.length === 0) { %>
    <div class="empty">No maintenance reports have been submitted yet.</div>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Store</th>
          <th>Submitted By</th>
          <th>Description</th>
          <th>Photos</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% reports.forEach(function(report) { %>
          <tr>
            <td><%= formatDateTime(report.submitted_at) %></td>
            <td><strong><%= report.store_name %></strong></td>
            <td><%= report.first_name %> <%= report.last_name %></td>
            <td style="max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= report.description %></td>
            <td><%= report.image_count %> image<%= parseInt(report.image_count) > 1 ? 's' : '' %></td>
            <td>
              <% if (report.status === 'reviewed') { %>
                <span class="badge" style="background: var(--green); color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem;">REVIEWED</span>
              <% } else { %>
                <span class="badge" style="background: var(--accent); color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem;">NEW</span>
              <% } %>
            </td>
            <td><a href="/operation-manager/maintenance/<%= report.id %>" class="btn" style="padding: 4px 12px; font-size: 0.8rem;">View</a></td>
          </tr>
        <% }); %>
      </tbody>
    </table>

    <% if (totalPages > 1) { %>
      <div style="margin-top: 1.25rem; display: flex; gap: 8px; justify-content: center;">
        <% if (page > 1) { %>
          <a href="?page=<%= page - 1 %>" class="btn" style="padding: 4px 12px;">&laquo; Prev</a>
        <% } %>
        <span style="padding: 6px 12px; color: var(--text-muted);">Page <%= page %> of <%= totalPages %></span>
        <% if (page < totalPages) { %>
          <a href="?page=<%= page + 1 %>" class="btn" style="padding: 4px 12px;">Next &raquo;</a>
        <% } %>
      </div>
    <% } %>
  <% } %>

<%- include('../partials/footer') %>
