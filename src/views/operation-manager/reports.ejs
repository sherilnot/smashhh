<%- include('../partials/header', { title: 'Management Reports', role: 'operation_manager', active: 'reports' }) %>

  <h1>Management Reports</h1>
  <p style="color: var(--text-muted); margin-bottom: 1.25rem;">Reports submitted by shop managers.</p>

  <% if (reports.length === 0) { %>
    <div class="empty">No management reports have been submitted yet.</div>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Store</th>
          <th>Submitted By</th>
          <th>Report</th>
          <th>Photos</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% reports.forEach(function(rep) { %>
          <tr>
            <td><%= new Date(rep.submitted_at).toLocaleString('en-AU', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) %></td>
            <td><strong><%= rep.store_name %></strong></td>
            <td><%= rep.first_name %> <%= rep.last_name %></td>
            <td style="color: var(--text-muted); max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= rep.report_text %></td>
            <td><%= rep.image_count %> image<%= parseInt(rep.image_count) === 1 ? '' : 's' %></td>
            <td>
              <% if (rep.status === 'reviewed') { %>
                <span class="badge" style="background: var(--green); color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem;">REVIEWED</span>
              <% } else { %>
                <span class="badge" style="background: var(--accent); color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem;">NEW</span>
              <% } %>
            </td>
            <td><a href="/operation-manager/reports/<%= rep.id %>" class="btn" style="padding: 4px 12px; font-size: 0.8rem;">View</a></td>
          </tr>
        <% }); %>
      </tbody>
    </table>

    <% if (totalPages > 1) { %>
      <div style="margin-top: 1.25rem; display: flex; gap: 8px; justify-content: center;">
        <% if (page > 1) { %>
          <a href="?page=<%= page - 1 %>" class="btn" style="padding: 4px 12px;">&laquo; Prev</a>
        <% } %>
        <span style="padding: 6px 12px; color: var(--text-muted);">Page <%= page %> of <%= totalPages %></span>
        <% if (page < totalPages) { %>
          <a href="?page=<%= page + 1 %>" class="btn" style="padding: 4px 12px;">Next &raquo;</a>
        <% } %>
      </div>
    <% } %>
  <% } %>

<%- include('../partials/footer') %>
