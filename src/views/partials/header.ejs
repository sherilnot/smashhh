<%
  var navRole = (typeof role !== 'undefined' && role) ? role : '';
  var activeKey = (typeof active !== 'undefined' && active) ? active : '';
  var menus = {
    employee: [
      { key: 'dashboard', href: '/employee/dashboard', icon: 'layout-dashboard', label: 'Dashboard' },
      { key: 'my-roster', href: '/employee/my-roster', icon: 'calendar-range',   label: 'My Roster' },
      { key: 'shifts',    href: '/employee/shifts',    icon: 'calendar-plus',    label: 'Available Shifts' },
      { key: 'my-shifts', href: '/employee/my-shifts', icon: 'calendar-check',   label: 'My Shifts' }
    ],
    store_manager: [
      { key: 'dashboard', href: '/manager/dashboard',        icon: 'layout-dashboard', label: 'Dashboard' },
      { key: 'checklist', href: '/manager/store-checklist',  icon: 'clipboard-list',   label: 'Daily Checklist' },
      { key: 'invoice',   href: '/manager/received-invoice', icon: 'package-check',    label: 'Received Invoice' },
      { key: 'cash',      href: '/manager/cash',             icon: 'banknote',         label: 'Cash Report' },
      { key: 'maintenance', href: '/manager/maintenance',    icon: 'wrench',           label: 'Maintenance' },
      { key: 'roster',    href: '/manager/roster',           icon: 'users',            label: 'Weekly Roster' },
      { key: 'timesheet', href: '/manager/timesheet',        icon: 'clock',            label: 'Timesheet' },
      { key: 'pending',   href: '/manager/pending',          icon: 'bell-dot',         label: 'Pending' },
      { key: 'employees', href: '/manager/employees',        icon: 'user-circle',      label: 'Employees' }
    ],
    warehouse_manager: [
      { key: 'dashboard',        href: '/warehouse/dashboard',        icon: 'layout-dashboard', label: 'Dashboard' },
      { key: 'store-checklists', href: '/warehouse/store-checklists', icon: 'clipboard-list',   label: 'Store Orders' }
    ],
    receiving_manager: [
      { key: 'dashboard',  href: '/receiving-manager/dashboard', icon: 'layout-dashboard', label: 'Dashboard' },
      { key: 'timesheets', href: '/receiving-manager/timesheets', icon: 'file-spreadsheet', label: 'All Timesheets' },
      { key: 'weekly',     href: '/receiving-manager/wages-weekly', icon: 'calendar',       label: 'Weekly Wages' },
      { key: 'monthly',    href: '/receiving-manager/wages-monthly', icon: 'calendar-range', label: 'Monthly Wages' },
      { key: 'wages',      href: '/receiving-manager/wages',      icon: 'banknote',         label: 'Rates' },
      { key: 'cash',       href: '/receiving-manager/cash',       icon: 'wallet',           label: 'Cash Reports' }
    ],
    operation_manager: [
      { key: 'dashboard', href: '/operation-manager/dashboard', icon: 'layout-dashboard', label: 'Dashboard' },
      { key: 'invoices',  href: '/operation-manager/invoices',  icon: 'package-check',    label: 'Invoices' },
      { key: 'cash',      href: '/operation-manager/cash',      icon: 'banknote',         label: 'Cash Reports' },
      { key: 'maintenance', href: '/operation-manager/maintenance', icon: 'tool',          label: 'Maintenance' }
    ]
  };
  var items = menus[navRole] || [];
  var roleLabel = { employee: 'Crew', store_manager: 'Manager', warehouse_manager: 'Warehouse', receiving_manager: 'Payroll', operation_manager: 'Operations' }[navRole] || '';
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title><%= typeof title !== 'undefined' ? title : 'Rizins' %></title>

  <!-- PWA -->
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#1a1a1a" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Rizins" />
  <link rel="apple-touch-icon" href="/icons/icon-192.png" />

  <link rel="stylesheet" href="/css/theme.css?v=5" />
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
  <% if (navRole === 'employee') { %>
  <script src="/js/webpush-notifications.js"></script>
  <% } %>
</head>
<%
  /* Pages opt into live updates by passing `live` (a comma-separated list of
     topics) into this header include. Example:
       include('../partials/header', { ..., live: 'checklist:submitted' })
     The realtime client only connects when at least one topic is present. */
  var liveTopics = (typeof live !== 'undefined' && live) ? String(live) : '';
%>
<body<% if (liveTopics) { %> data-realtime="<%= liveTopics %>"<% } %>>
  <header class="topbar">
    <% if (items.length) { %>
    <button class="menu-toggle" id="menuToggle" aria-label="Open menu">
      <i data-lucide="menu" class="nav-icon"></i>
    </button>
    <% } %>
    <span class="brand">
      <img src="/images/logo.png" alt="Rizins" style="height: 42px; width: auto;">
      Rizins <span class="accent">Smash</span>
    </span>
    <span class="spacer"></span>
    <% if (roleLabel) { %><span class="who"><%= roleLabel %></span><% } %>
  </header>
  <!-- Overlay for mobile sidebar -->
  <div class="sidebar-overlay" id="sidebarOverlay"></div>
  <div class="layout">
    <% if (items.length) { %>
    <aside class="sidebar">
      <div class="section-label">Navigation</div>
      <% items.forEach(function(it){ %>
        <a href="<%= it.href %>" class="<%= activeKey === it.key ? 'active' : '' %>">
          <i data-lucide="<%= it.icon %>" class="nav-icon"></i>
          <span><%= it.label %></span>
        </a>
      <% }); %>
      <div class="logout">
        <form method="POST" action="/logout">
          <button type="submit"><i data-lucide="log-out" class="nav-icon"></i><span>Sign out</span></button>
        </form>
      </div>
    </aside>
    <% } %>
    <main class="content<%= (typeof wide !== 'undefined' && wide) ? ' content-wide' : '' %>">
