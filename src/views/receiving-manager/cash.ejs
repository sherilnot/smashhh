<%- include('../partials/header', { title: 'Cash Reports', role: 'receiving_manager', active: 'cash', live: 'cash:submitted' }) %>

  <h1>Cash Reports by Store</h1>

  <% var storeNames = Object.keys(byStore); %>
  <% if (storeNames.length === 0) { %>
    <div class="empty">No cash reports submitted yet.</div>
  <% } else { %>

    <p style="font-size:0.8rem; color:var(--muted); margin-bottom:1rem;">
      <%= total %> report<%= total !== 1 ? 's' : '' %> total · Tap a store to expand
    </p>

    <div style="display:flex; flex-direction:column; gap:0.6rem;">
      <% storeNames.forEach(function(storeName, storeIdx) { %>
        <% var subs = byStore[storeName]; %>
        <%
          var storeTotal = 0;
          subs.forEach(function(s) { storeTotal += parseFloat(s.amount) || 0; });
        %>
        <div style="background:var(--warm-white); border:1px solid var(--border); border-radius:12px; overflow:hidden; box-shadow:var(--shadow);">
          <!-- Store header -->
          <div onclick="toggleStore('<%= storeIdx %>')" style="display:flex; align-items:center; justify-content:space-between; padding:0.85rem 1.1rem; cursor:pointer; user-select:none;">
            <div>
              <span style="font-weight:700; font-size:1rem; color:var(--bun-dark);"><%= storeName %></span>
              <span style="font-size:0.78rem; color:var(--muted); margin-left:0.5rem;">(<%= subs.length %>)</span>
            </div>
            <div style="display:flex; align-items:center; gap:0.75rem;">
              <span style="font-weight:700; font-size:0.92rem; color:var(--bun-dark);">$<%= storeTotal.toFixed(2) %></span>
              <span id="arrow-<%= storeIdx %>" style="font-size:1.1rem; color:var(--muted); transition:transform 0.2s;">▸</span>
            </div>
          </div>

          <!-- Wages history: weekly + monthly scrollable tables -->
          <%
            var w = (typeof wagesByStore !== 'undefined' && wagesByStore[storeName])
              ? wagesByStore[storeName]
              : { weeks: [], months: [] };
          %>
          <div style="border-top:1px solid var(--border); background:#f7f9fc; padding:0.7rem 1.1rem;">
            <!-- Weekly -->
            <div style="font-size:0.62rem; font-weight:700; color:var(--muted); text-transform:uppercase; letter-spacing:0.4px; margin-bottom:0.3rem;">Weekly Wages</div>
            <div style="max-height:160px; overflow-y:auto; border:1px solid var(--border); border-radius:8px; background:#fff; margin-bottom:0.6rem;">
              <% if (w.weeks && w.weeks.length > 0) { %>
                <table style="width:100%; border-collapse:collapse; margin:0; border:none; box-shadow:none; border-radius:0; font-size:0.78rem;">
                  <thead>
                    <tr>
                      <th style="padding:0.35rem 0.6rem; text-align:left; background:#eef2f7; font-size:0.62rem; border-bottom:1px solid var(--border); font-weight:700; color:var(--muted);">Week</th>
                      <th style="padding:0.35rem 0.6rem; text-align:right; background:#eef2f7; font-size:0.62rem; border-bottom:1px solid var(--border); font-weight:700; color:var(--muted);">Hours</th>
                      <th style="padding:0.35rem 0.6rem; text-align:right; background:#eef2f7; font-size:0.62rem; border-bottom:1px solid var(--border); font-weight:700; color:var(--muted);">Pay</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% w.weeks.forEach(function(wk) { %>
                      <tr>
                        <td style="padding:0.3rem 0.6rem; border-bottom:1px solid #f0f0f0; font-weight:600;"><%= formatDate(wk.weekStart) %></td>
                        <td style="padding:0.3rem 0.6rem; border-bottom:1px solid #f0f0f0; text-align:right; color:var(--muted);"><%= wk.hours.toFixed(1) %>h</td>
                        <td style="padding:0.3rem 0.6rem; border-bottom:1px solid #f0f0f0; text-align:right; font-weight:700; color:#1b5e20;">$<%= wk.pay.toFixed(2) %></td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              <% } else { %>
                <div style="padding:0.75rem; text-align:center; color:var(--muted); font-size:0.78rem;">No weekly data yet</div>
              <% } %>
            </div>

            <!-- Monthly -->
            <div style="font-size:0.62rem; font-weight:700; color:var(--muted); text-transform:uppercase; letter-spacing:0.4px; margin-bottom:0.3rem;">Monthly Wages</div>
            <div style="max-height:130px; overflow-y:auto; border:1px solid var(--border); border-radius:8px; background:#fff;">
              <% if (w.months && w.months.length > 0) { %>
                <table style="width:100%; border-collapse:collapse; margin:0; border:none; box-shadow:none; border-radius:0; font-size:0.78rem;">
                  <thead>
                    <tr>
                      <th style="padding:0.35rem 0.6rem; text-align:left; background:#eef2f7; font-size:0.62rem; border-bottom:1px solid var(--border); font-weight:700; color:var(--muted);">Month</th>
                      <th style="padding:0.35rem 0.6rem; text-align:right; background:#eef2f7; font-size:0.62rem; border-bottom:1px solid var(--border); font-weight:700; color:var(--muted);">Hours</th>
                      <th style="padding:0.35rem 0.6rem; text-align:right; background:#eef2f7; font-size:0.62rem; border-bottom:1px solid var(--border); font-weight:700; color:var(--muted);">Pay</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% w.months.forEach(function(mo) { %>
                      <tr>
                        <td style="padding:0.3rem 0.6rem; border-bottom:1px solid #f0f0f0; font-weight:600;"><%= mo.label %></td>
                        <td style="padding:0.3rem 0.6rem; border-bottom:1px solid #f0f0f0; text-align:right; color:var(--muted);"><%= mo.hours.toFixed(1) %>h</td>
                        <td style="padding:0.3rem 0.6rem; border-bottom:1px solid #f0f0f0; text-align:right; font-weight:700; color:#0d47a1;">$<%= mo.pay.toFixed(2) %></td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              <% } else { %>
                <div style="padding:0.75rem; text-align:center; color:var(--muted); font-size:0.78rem;">No monthly data yet</div>
              <% } %>
            </div>
          </div>

          <!-- Submissions list -->
          <div id="store-<%= storeIdx %>" style="display:none; border-top:1px solid var(--border);">
            <% subs.forEach(function(sub) { %>
              <a href="/receiving-manager/cash/<%= sub.id %>"
                 style="display:flex; align-items:center; gap:0.75rem; padding:0.65rem 1.1rem; text-decoration:none; color:var(--ink); border-top:1px solid var(--border);">
                <div style="flex:1; min-width:0;">
                  <div style="font-weight:600; font-size:0.9rem;">$<%= parseFloat(sub.amount).toFixed(2) %></div>
                  <div style="font-size:0.73rem; color:var(--muted);">
                    <%= formatDateTime(sub.submitted_at) %> · <%= sub.first_name %> <%= sub.last_name %> · 📷 <%= sub.image_count %>
                  </div>
                </div>
                <% if (sub.status === 'reviewed') { %>
                  <span style="font-size:0.63rem; padding:0.15rem 0.4rem; background:#e8f5e9; color:#2e7d32; border-radius:6px; font-weight:600;">REVIEWED</span>
                <% } else { %>
                  <span style="font-size:0.63rem; padding:0.15rem 0.4rem; background:#fef3e2; color:var(--bun-dark); border-radius:6px; font-weight:600;">NEW</span>
                <% } %>
                <span style="color:var(--muted); font-size:0.9rem;">›</span>
              </a>
            <% }); %>
          </div>
        </div>
      <% }); %>
    </div>

  <% } %>

  <script>
    function toggleStore(idx) {
      var panel = document.getElementById('store-' + idx);
      var arrow = document.getElementById('arrow-' + idx);
      if (panel.style.display === 'none') {
        panel.style.display = 'block';
        arrow.style.transform = 'rotate(90deg)';
      } else {
        panel.style.display = 'none';
        arrow.style.transform = 'rotate(0deg)';
      }
    }
  </script>

<%- include('../partials/footer') %>
