<%- include('../partials/header', { title: 'Shop Expenses', role: 'receiving_manager', active: 'expenses', live: 'expense:submitted,expense:updated' }) %>

  <style>
    .xr-bar { display:flex; align-items:center; justify-content:space-between; gap:0.5rem; margin-bottom:1rem; }
    .xr-nav { display:flex; align-items:center; gap:0.35rem; }
    .xr-nav a, .xr-nav span.off { width:2.2rem; height:2.2rem; display:flex; align-items:center; justify-content:center;
                                   border:1px solid var(--border); border-radius:8px; background:var(--warm-white);
                                   color:var(--ink); text-decoration:none; font-size:1.1rem; }
    .xr-nav span.off { opacity:0.35; }
    .xr-nav strong { min-width:8.5rem; text-align:center; font-size:1rem; }
    .xr-csv { display:inline-flex; align-items:center; gap:0.3rem; padding:0.5rem 0.75rem; border-radius:8px;
              border:1px solid var(--border); background:var(--warm-white); color:var(--ink);
              font-size:0.82rem; font-weight:600; text-decoration:none; white-space:nowrap; }

    .xr-total { background:linear-gradient(135deg, #2a1507, #3d1e06); color:#fff; border-radius:14px;
                padding:1rem 1.15rem; margin-bottom:1rem; box-shadow:var(--shadow-md); }
    .xr-total-lbl { font-size:0.72rem; text-transform:uppercase; letter-spacing:0.6px; opacity:0.7; }
    .xr-total-val { font-size:1.9rem; font-weight:800; font-variant-numeric:tabular-nums; line-height:1.2; }
    .xr-total-sub { font-size:0.8rem; opacity:0.8; margin-top:0.15rem; }
    .xr-up { color:#ffb4ae; } .xr-down { color:#a5e3b8; }

    .xr-shop { background:var(--warm-white); border:1px solid var(--border); border-radius:12px;
               margin-bottom:0.6rem; box-shadow:var(--shadow); overflow:hidden; }
    .xr-shop summary { list-style:none; cursor:pointer; padding:0.85rem 1rem; }
    .xr-shop summary::-webkit-details-marker { display:none; }
    .xr-shop-top { display:flex; justify-content:space-between; align-items:baseline; gap:0.75rem; }
    .xr-shop-name { font-weight:700; color:var(--bun-dark); }
    .xr-shop-count { font-size:0.75rem; color:var(--muted); margin-left:0.35rem; font-weight:500; }
    .xr-shop-amt { font-weight:800; font-variant-numeric:tabular-nums; font-size:1.05rem; color:var(--ink); }
    .xr-shop-amt.zero { color:var(--muted); font-weight:600; }
    .xr-meter { height:6px; border-radius:999px; background:var(--border); margin:0.55rem 0 0.5rem; overflow:hidden; }
    .xr-meter span { display:block; height:100%; border-radius:999px; background:linear-gradient(90deg, var(--ketchup), var(--mustard)); }
    .xr-chips { display:flex; flex-wrap:wrap; gap:0.3rem; }
    .xr-chip { font-size:0.72rem; padding:0.15rem 0.5rem; border-radius:999px; background:var(--cream);
               border:1px solid var(--border); color:var(--text-secondary); white-space:nowrap; }
    .xr-more { font-size:0.72rem; color:var(--muted); margin-top:0.45rem; }
    .xr-shop[open] .xr-more { display:none; }

    .xr-list { border-top:1px solid var(--border); }
    .xr-item { padding:0.7rem 1rem; border-bottom:1px solid #f2ede6; }
    .xr-item:last-child { border-bottom:none; }
    .xr-item-top { display:flex; gap:0.6rem; align-items:flex-start; }
    .xr-item-icon { font-size:1.1rem; line-height:1.4; }
    .xr-item-main { flex:1; min-width:0; }
    .xr-item-desc { font-weight:600; font-size:0.88rem; }
    .xr-item-meta { font-size:0.72rem; color:var(--muted); }
    .xr-item-amt { font-weight:700; font-variant-numeric:tabular-nums; white-space:nowrap; }
    .xr-thumbs { display:flex; gap:0.4rem; margin:0.45rem 0 0 1.7rem; flex-wrap:wrap; }
    .xr-thumbs img { width:56px; height:56px; object-fit:cover; border-radius:8px; border:1px solid var(--border); }
    .xr-empty { padding:0.9rem 1rem; color:var(--muted); font-size:0.82rem; border-top:1px solid var(--border); }

    .xr-trend th, .xr-trend td { text-align:right; white-space:nowrap; font-variant-numeric:tabular-nums; }
    .xr-trend th:first-child, .xr-trend td:first-child { text-align:left; }
    .xr-trend .cur { background:rgba(244,163,0,0.12); font-weight:700; }
    .xr-trend a { color:inherit; text-decoration:none; }
  </style>

  <h1>Shop Expenses</h1>

  <% if (error) { %><div class="error"><%= error %></div><% } %>

  <div class="xr-bar">
    <div class="xr-nav">
      <a href="/receiving-manager/expenses?month=<%= prevMonth %>" aria-label="Previous month">‹</a>
      <strong><%= monthLabel %></strong>
      <% if (nextMonth) { %>
        <a href="/receiving-manager/expenses?month=<%= nextMonth %>" aria-label="Next month">›</a>
      <% } else { %>
        <span class="off">›</span>
      <% } %>
    </div>
    <a class="xr-csv" href="/receiving-manager/expenses-export?month=<%= month %>">
      <i data-lucide="download" style="width:16px; height:16px;"></i> CSV
    </a>
  </div>

  <%
    var diff = Math.round((report.total - previousTotal) * 100) / 100;
    var maxShop = report.stores.reduce(function(m, s) { return Math.max(m, s.total); }, 0);
    var catOf = function(key) {
      return categories.find(function(c) { return c.key === key; }) || categories[categories.length - 1];
    };
  %>

  <div class="xr-total">
    <div class="xr-total-lbl">All shops · <%= monthLabel %></div>
    <div class="xr-total-val">$<%= report.total.toFixed(2) %></div>
    <div class="xr-total-sub">
      <%= report.count %> expense<%= report.count !== 1 ? 's' : '' %>
      <% if (previousTotal > 0 || report.total > 0) { %>
        · <% if (diff > 0) { %><span class="xr-up">▲ $<%= diff.toFixed(2) %></span><% } else if (diff < 0) { %><span class="xr-down">▼ $<%= Math.abs(diff).toFixed(2) %></span><% } else { %>same<% } %>
        vs last month
      <% } %>
    </div>
  </div>

  <% report.stores.forEach(function(store) { %>
    <details class="xr-shop">
      <summary>
        <div class="xr-shop-top">
          <div>
            <span class="xr-shop-name"><%= store.name %></span>
            <span class="xr-shop-count"><%= store.count %> expense<%= store.count !== 1 ? 's' : '' %></span>
          </div>
          <span class="xr-shop-amt<%= store.total ? '' : ' zero' %>">$<%= store.total.toFixed(2) %></span>
        </div>
        <div class="xr-meter"><span style="width:<%= store.total > 0 ? Math.max(2, Math.round(store.total / maxShop * 100)) : 0 %>%;"></span></div>
        <div class="xr-chips">
          <% categories.forEach(function(c) { if (store.categories[c.key]) { %>
            <span class="xr-chip"><%= c.icon %> <%= c.label %> $<%= store.categories[c.key].toFixed(2) %></span>
          <% } }); %>
        </div>
        <% if (store.count > 0) { %><div class="xr-more">Tap to see each expense</div><% } %>
      </summary>

      <% if (store.count === 0) { %>
        <div class="xr-empty">No expenses this month.</div>
      <% } else { %>
        <div class="xr-list">
          <% store.expenses.forEach(function(x) { var c = catOf(x.category); %>
            <div class="xr-item">
              <div class="xr-item-top">
                <span class="xr-item-icon"><%= c.icon %></span>
                <div class="xr-item-main">
                  <div class="xr-item-desc"><%= x.description %></div>
                  <div class="xr-item-meta"><%= formatDateShort(x.spent_on) %> · <%= c.label %> · <%= x.first_name %> <%= x.last_name || '' %></div>
                </div>
                <span class="xr-item-amt">$<%= parseFloat(x.amount).toFixed(2) %></span>
              </div>
              <% if (x.images.length) { %>
                <div class="xr-thumbs">
                  <% x.images.forEach(function(img) { %>
                    <a href="/uploads/expenses/<%= img.filename %>" target="_blank" rel="noopener">
                      <img src="/uploads/expenses/<%= img.filename %>" alt="Receipt" loading="lazy">
                    </a>
                  <% }); %>
                </div>
              <% } %>
            </div>
          <% }); %>
        </div>
      <% } %>
    </details>
  <% }); %>

  <% if (trend.rows.length) { %>
    <h2 style="font-size:1rem; color:var(--muted); margin:1.75rem 0 0.25rem;">Last 6 months</h2>
    <div class="table-scroll">
      <table class="xr-trend">
        <thead>
          <tr>
            <th>Shop</th>
            <% trend.months.forEach(function(m) { %>
              <th class="<%= m.month === month ? 'cur' : '' %>"><a href="/receiving-manager/expenses?month=<%= m.month %>"><%= m.label %></a></th>
            <% }); %>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          <% trend.rows.forEach(function(r) { %>
            <tr>
              <td><strong><%= r.name %></strong></td>
              <% r.totals.forEach(function(t, i) { %>
                <td class="<%= trend.months[i].month === month ? 'cur' : '' %>"><%= t ? '$' + t.toFixed(0) : '–' %></td>
              <% }); %>
              <td><strong>$<%= r.sum.toFixed(0) %></strong></td>
            </tr>
          <% }); %>
        </tbody>
        <tfoot>
          <tr>
            <td>All shops</td>
            <% trend.columnTotals.forEach(function(t, i) { %>
              <td class="<%= trend.months[i].month === month ? 'cur' : '' %>">$<%= t.toFixed(0) %></td>
            <% }); %>
            <td>$<%= trend.columnTotals.reduce(function(a, b) { return a + b; }, 0).toFixed(0) %></td>
          </tr>
        </tfoot>
      </table>
    </div>
  <% } %>

<%- include('../partials/footer') %>
