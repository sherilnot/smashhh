<%- include('../partials/header', { title: 'Timesheet Detail', role: 'receiving_manager', active: 'timesheets', wide: true }) %>

  <h1>Timesheet</h1>

  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <div id="msg"></div>

  <% if (timesheet) { %>

    <!-- Week info -->
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; padding:0.6rem 0.85rem; background:var(--warm-white); border:1px solid var(--border); border-radius:10px; flex-wrap:wrap; gap:0.5rem;">
      <div>
        <strong style="font-size:0.95rem; color:var(--bun-dark);"><%= timesheet.store_name %></strong>
        <div style="font-size:0.78rem; color:var(--muted);"><%= formatDate(timesheet.week_start) %> — <%= formatDate(timesheet.week_end) %></div>
      </div>
      <span style="font-size:0.7rem; padding:0.2rem 0.55rem; background:<%= timesheet.status === 'confirmed' ? '#e8f5e9' : '#fff3e0' %>; color:<%= timesheet.status === 'confirmed' ? '#2e7d32' : '#e65100' %>; border-radius:8px; font-weight:700;">
        <%= timesheet.status === 'confirmed' ? '✓ CONFIRMED' : 'SUBMITTED' %>
      </span>
    </div>

    <% if (timesheet.timesheetRows && timesheet.timesheetRows.length > 0) { %>

      <!-- Actions -->
      <div class="ts-actions" style="display:flex; gap:0.5rem; flex-wrap:wrap; margin-bottom:0.85rem;">
        <a href="/receiving-manager/timesheets/<%= timesheet.id %>/download"
           style="padding:0.6rem 1rem; font-size:0.84rem; font-weight:700; background:linear-gradient(135deg,#1d6f42,#217346); color:#fff; border-radius:9px; text-decoration:none;">
          ⬇ Download Excel
        </a>
        <button onclick="window.print()"
                style="padding:0.6rem 1rem; font-size:0.84rem; font-weight:700; background:linear-gradient(135deg,#1f4e79,#2e75b6); color:#fff; border:none; border-radius:9px; cursor:pointer;">
          🖨 Print
        </button>
      </div>

      <!-- Weekend Multiplier Controls -->
      <div class="ts-actions" style="margin-bottom:0.75rem; padding:0.6rem 0.75rem; background:linear-gradient(135deg,#fef3e2,#fdefd8); border-radius:10px; display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
        <input type="checkbox" id="selectAllCb" onchange="toggleAll()" style="width:16px; height:16px; accent-color:var(--charcoal);">
        <span style="font-size:0.8rem; font-weight:600;">Weekend rate:</span>
        <button type="button" onclick="applyWeekendRate(1.5)" style="padding:0.3rem 0.7rem; font-size:0.75rem; background:#2e7d32; color:white; border:none; border-radius:6px; font-weight:700; cursor:pointer;">1.5x</button>
        <button type="button" onclick="applyWeekendRate(2.0)" style="padding:0.3rem 0.7rem; font-size:0.75rem; background:#1565c0; color:white; border:none; border-radius:6px; font-weight:700; cursor:pointer;">2.0x</button>
        <button type="button" onclick="resetAll()" style="padding:0.3rem 0.7rem; font-size:0.75rem; background:white; color:#666; border:1px solid var(--border); border-radius:6px; cursor:pointer;">Reset</button>
        <span id="selectedCount" style="font-size:0.7rem; color:var(--muted); margin-left:auto;">0 selected</span>
      </div>

      <!-- Excel-style grid -->
      <%- include('../partials/timesheet-grid', { timesheet: timesheet, showCheckboxes: true, showPayColumn: true }) %>

    <% } else { %>
      <div class="empty">No shifts in this timesheet.</div>
    <% } %>

    <p style="margin-top:1rem;" class="no-print"><a href="/receiving-manager/timesheets" style="color:var(--lettuce-dark); font-weight:700; font-size:0.85rem;">← All Timesheets</a></p>
  <% } %>

  <script>
    var timesheetId = '<%= timesheet ? timesheet.id : "" %>';

    function updateCount() {
      var count = document.querySelectorAll('.emp-cb:checked').length;
      var el = document.getElementById('selectedCount');
      if (el) el.textContent = count + ' selected';
    }

    function toggleAll() {
      var cbs = document.querySelectorAll('.emp-cb');
      var allChecked = Array.from(cbs).every(function(c) { return c.checked; });
      cbs.forEach(function(c) { c.checked = !allChecked; });
      document.getElementById('selectAllCb').checked = !allChecked;
      updateCount();
    }

    async function applyWeekendRate(multiplier) {
      var checked = document.querySelectorAll('.emp-cb:checked');
      if (checked.length === 0) { document.getElementById('msg').className = 'error'; document.getElementById('msg').textContent = 'Select employees first.'; return; }
      var names = Array.from(checked).map(function(c) { return c.dataset.name; });
      if (!confirm('Apply ' + multiplier + 'x weekend rate to ' + names.length + ' employee(s)?')) return;
      var res = await fetch('/receiving-manager/apply-multiplier', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ timesheetId: timesheetId, employeeIds: names, multiplier: multiplier })
      });
      var data = await res.json();
      if (data.success) { window.location.reload(); }
      else { document.getElementById('msg').className = 'error'; document.getElementById('msg').textContent = data.error || 'Failed.'; }
    }

    async function resetAll() {
      var checked = document.querySelectorAll('.emp-cb:checked');
      if (checked.length === 0) { document.getElementById('msg').className = 'error'; document.getElementById('msg').textContent = 'Select employees first.'; return; }
      var names = Array.from(checked).map(function(c) { return c.dataset.name; });
      if (!confirm('Reset rates for ' + names.length + ' employee(s)?')) return;
      for (var i = 0; i < names.length; i++) {
        await fetch('/receiving-manager/remove-multiplier', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ timesheetId: timesheetId, employeeId: names[i] })
        });
      }
      window.location.reload();
    }
  </script>

<%- include('../partials/footer') %>
