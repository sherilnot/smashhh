<%- include('../partials/header', { title: 'Timesheets', role: 'receiving_manager', active: 'timesheets' }) %>

  <h1>Timesheets</h1>

  <% if (error) { %><div class="error"><%= error %></div><% } %>

  <% if (timesheets.length === 0 && !error) { %>
    <div class="empty">No timesheets submitted yet.</div>
  <% } else if (timesheets.length > 0) { %>
    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
      <% timesheets.forEach(ts => { %>
        <a href="/receiving-manager/timesheets/<%= ts.id %>" style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; background: var(--warm-white); border: 1px solid var(--border); border-radius: 12px; text-decoration: none; color: var(--ink); box-shadow: var(--shadow);">
          <div style="flex: 1; min-width: 0;">
            <div style="font-weight: 700; font-size: 0.95rem;"><%= ts.store_name %></div>
            <div style="font-size: 0.8rem; color: var(--muted); margin-top: 0.15rem;">
              <%= formatDate(ts.week_start) %> — <%= formatDate(ts.week_end) %>
            </div>
            <div style="font-size: 0.75rem; color: var(--muted); margin-top: 0.1rem;">
              <%= ts.employee_count %> employees · <%= parseFloat(ts.total_hours).toFixed(1) %>h · <%= formatDateShort(ts.submitted_at) %>
            </div>
          </div>
          <% if (ts.status === 'confirmed') { %>
            <span style="font-size: 0.65rem; padding: 0.15rem 0.4rem; background: #e8f5e9; color: #2e7d32; border-radius: 6px; font-weight: 600; flex-shrink: 0;">CONFIRMED</span>
          <% } else { %>
            <span style="font-size: 0.65rem; padding: 0.15rem 0.4rem; background: #fef3e2; color: var(--bun-dark); border-radius: 6px; font-weight: 600; flex-shrink: 0;">DRAFT</span>
          <% } %>
          <span style="color: var(--muted); font-size: 1rem;">›</span>
        </a>
      <% }) %>
    </div>

    <% if (totalPages > 1) { %>
      <div style="margin-top: 1.25rem; display: flex; gap: 8px; justify-content: center;">
        <% if (page > 1) { %>
          <a href="?page=<%= page - 1 %>" style="padding: 0.4rem 1rem; background: var(--warm-white); border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: var(--ink); font-size: 0.85rem;">← Prev</a>
        <% } %>
        <span style="padding: 0.4rem 0.75rem; color: var(--muted); font-size: 0.85rem;">Page <%= page %>/<%= totalPages %></span>
        <% if (page < totalPages) { %>
          <a href="?page=<%= page + 1 %>" style="padding: 0.4rem 1rem; background: var(--warm-white); border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: var(--ink); font-size: 0.85rem;">Next →</a>
        <% } %>
      </div>
    <% } %>
  <% } %>

<%- include('../partials/footer') %>
