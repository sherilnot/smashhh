<%- include('../partials/header', { title: 'Submitted Timesheets', role: 'receiving_manager', active: 'timesheets' }) %>

  <h1>Payroll — Timesheets</h1>

  <% if (error) { %>
    <div class="error"><%= error %></div>
  <% } %>

  <% if (timesheets.length === 0 && !error) { %>
    <div class="empty">No timesheets have been submitted yet.</div>
  <% } else if (timesheets.length > 0) { %>
    <div class="card" style="margin-bottom: 1rem;">
      <strong><%= total %></strong> timesheet(s) submitted.
    </div>

    <table>
      <thead>
        <tr>
          <th>Store</th>
          <th>Week</th>
          <th class="amount">Employees</th>
          <th class="amount">Total Hours</th>
          <th>Submitted</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% timesheets.forEach(ts => { %>
          <tr>
            <td><strong><%= ts.store_name %></strong></td>
            <td><%= formatDate(ts.week_start) %> — <%= formatDate(ts.week_end) %></td>
            <td class="amount"><%= ts.employee_count %></td>
            <td class="amount"><%= parseFloat(ts.total_hours).toFixed(2) %></td>
            <td><%= formatDateTime(ts.submitted_at) %></td>
            <td><a href="/receiving-manager/timesheets/<%= ts.id %>" class="btn" style="font-size: 0.8rem; padding: 0.35rem 0.7rem;">View</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <% if (totalPages > 1) { %>
      <div style="margin-top: 1rem; text-align: center;">
        <% if (page > 1) { %>
          <a href="/receiving-manager/timesheets?page=<%= page - 1 %>" style="color: var(--lettuce-dark); font-weight: 700;">← Previous</a>
        <% } %>
        <span style="margin: 0 1rem; color: var(--muted);">Page <%= page %> of <%= totalPages %></span>
        <% if (page < totalPages) { %>
          <a href="/receiving-manager/timesheets?page=<%= page + 1 %>" style="color: var(--lettuce-dark); font-weight: 700;">Next →</a>
        <% } %>
      </div>
    <% } %>
  <% } %>

<%- include('../partials/footer') %>
