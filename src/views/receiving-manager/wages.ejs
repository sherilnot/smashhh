<%- include('../partials/header', { title: 'Employee Wages', role: 'receiving_manager', active: 'wages' }) %>

  <h1>Wages</h1>

  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <div id="msg"></div>

  <% var stores = (typeof byStore !== 'undefined') ? byStore : {}; %>
  <% var storeNames = Object.keys(stores); %>

  <% if (storeNames.length === 0) { %>
    <div class="empty">No employees found.</div>
  <% } else { %>
    <div style="display: flex; flex-direction: column; gap: 0.75rem;">
      <% storeNames.forEach(function(storeName) { %>
        <% var employees = stores[storeName]; %>
        <details style="background: var(--warm-white); border: 1px solid var(--border); border-radius: 12px; overflow: hidden;">
          <summary style="padding: 0.75rem 1rem; font-weight: 700; font-size: 0.95rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem; background: linear-gradient(135deg, #fef3e2, #fdefd8); color: var(--bun-dark);">
            🏪 <%= storeName %>
            <span style="margin-left: auto; font-size: 0.7rem; padding: 0.15rem 0.5rem; background: var(--charcoal); color: white; border-radius: 8px;"><%= employees.length %></span>
          </summary>
          <div style="padding: 0.5rem;">
            <!-- Set all default button -->
            <div style="padding: 0.4rem 0.5rem; margin-bottom: 0.4rem; display: flex; justify-content: flex-end;">
              <button onclick="setStoreDefault('<%= storeName %>')" style="padding: 0.3rem 0.7rem; font-size: 0.7rem; background: #e3f2fd; color: #1565c0; border: 1px solid #90caf9; border-radius: 6px; font-weight: 600; cursor: pointer;">
                Set all to $23
              </button>
            </div>
            
            <% employees.forEach(function(emp) { %>
              <div class="emp-row" data-store="<%= storeName %>" data-id="<%= emp.id %>" style="display: flex; align-items: center; gap: 0.6rem; padding: 0.55rem 0.6rem; border-bottom: 1px solid var(--border);">
                <div style="flex: 1; min-width: 0;">
                  <div style="font-weight: 600; font-size: 0.85rem;"><%= emp.first_name %> <%= emp.last_name || '' %></div>
                  <% if (emp.employment_type === 'permanent') { %>
                    <span style="font-size: 0.6rem; color: var(--green);">Perm</span>
                  <% } else if (emp.employment_type === 'casual') { %>
                    <span style="font-size: 0.6rem; color: var(--mustard);">Casual</span>
                  <% } %>
                </div>
                <div id="display-<%= emp.id %>" style="display: flex; align-items: center; gap: 0.3rem;">
                  <strong style="font-size: 0.95rem;">$<span class="wage-val"><%= parseFloat(emp.hourly_wage || 0).toFixed(0) %></span></strong>
                  <span style="font-size: 0.75rem; color: var(--muted);">/hr</span>
                  <button onclick="setDefault('<%= emp.id %>')" style="padding: 0.15rem 0.4rem; font-size: 0.6rem; background: #e3f2fd; color: #1565c0; border: 1px solid #90caf9; border-radius: 4px; cursor: pointer; font-weight: 600;">$23</button>
                  <button onclick="startEdit('<%= emp.id %>')" style="width: 24px; height: 24px; border: 1px solid #90caf9; border-radius: 5px; background: #e3f2fd; color: #1565c0; cursor: pointer; font-size: 0.8rem;">✎</button>
                </div>
                <form id="edit-<%= emp.id %>" onsubmit="saveRate(event, '<%= emp.id %>')" style="display: none; align-items: center; gap: 0.2rem;">
                  $<input type="number" name="rate" step="0.5" min="0" value="<%= parseFloat(emp.hourly_wage || 0).toFixed(2) %>" style="width: 60px; padding: 0.3rem; border: 1px solid var(--border); border-radius: 5px; font-size: 0.85rem;">
                  <button type="submit" style="width: 24px; height: 24px; border-radius: 5px; border: 1px solid #c8e6c9; background: #e8f5e9; color: #2e7d32; cursor: pointer;">✓</button>
                  <button type="button" onclick="cancelEdit('<%= emp.id %>')" style="width: 24px; height: 24px; border-radius: 5px; border: 1px solid #f3c6c6; background: #fef2f2; color: #c62828; cursor: pointer;">✕</button>
                </form>
              </div>
            <% }); %>
          </div>
        </details>
      <% }); %>
    </div>
  <% } %>

  <script>
    function startEdit(id) {
      document.getElementById('display-' + id).style.display = 'none';
      document.getElementById('edit-' + id).style.display = 'flex';
      document.querySelector('#edit-' + id + ' input').focus();
    }
    function cancelEdit(id) {
      document.getElementById('edit-' + id).style.display = 'none';
      document.getElementById('display-' + id).style.display = 'flex';
    }
    async function saveRate(e, id) {
      e.preventDefault();
      var rate = e.target.querySelector('input').value;
      var res = await fetch('/receiving-manager/update-wage', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ employeeId: id, newRate: parseFloat(rate) })
      });
      var data = await res.json();
      if (data.success) {
        document.getElementById('display-' + id).querySelector('.wage-val').textContent = parseFloat(rate).toFixed(0);
        cancelEdit(id);
      }
    }
    async function setDefault(id) {
      var res = await fetch('/receiving-manager/update-wage', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ employeeId: id, newRate: 23 })
      });
      var data = await res.json();
      if (data.success) {
        document.getElementById('display-' + id).querySelector('.wage-val').textContent = '23';
      }
    }
    async function setStoreDefault(storeName) {
      if (!confirm('Set all employees in ' + storeName + ' to $23/hr?')) return;
      var rows = document.querySelectorAll('.emp-row[data-store="' + storeName + '"]');
      for (var row of rows) {
        var id = row.dataset.id;
        await fetch('/receiving-manager/update-wage', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ employeeId: id, newRate: 23 })
        });
        row.querySelector('.wage-val').textContent = '23';
      }
      document.getElementById('msg').className = 'msg';
      document.getElementById('msg').textContent = storeName + ': all set to $23/hr';
    }
  </script>

<%- include('../partials/footer') %>
