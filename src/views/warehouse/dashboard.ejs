<%- include('../partials/header', { title: 'Warehouse Dashboard', role: 'warehouse_manager', active: 'dashboard' }) %>

  <h1>Warehouse Dashboard</h1>

  <div class="card">
    <p>Review submitted store checklists and manage inventory deliveries.</p>
  </div>

  <h2>Recent Store Orders</h2>

  <% if (checklists && checklists.length > 0) { %>
    <table>
      <thead>
        <tr>
          <th>Store</th>
          <th>Date</th>
          <th>Submitted By</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% checklists.forEach(cl => { %>
          <tr>
            <td><strong><%= cl.store_name %></strong></td>
            <td><%= formatDate(cl.check_date) %></td>
            <td><%= cl.first_name %> <%= cl.last_name %></td>
            <td>
              <span class="badge" style="background: <%= cl.status === 'reviewed' ? 'var(--lettuce)' : 'var(--mustard)' %>; color: <%= cl.status === 'reviewed' ? '#fff' : 'var(--bun-dark)' %>;">
                <%= cl.status %>
              </span>
            </td>
            <td><a href="/warehouse/store-checklists/<%= cl.id %>" class="btn" style="font-size: 0.8rem; padding: 0.35rem 0.7rem;">View</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <% if (total > 10) { %>
      <p style="margin-top: 0.75rem;"><a href="/warehouse/store-checklists" style="color: var(--lettuce-dark); font-weight: 700;">View all (<%= total %>) →</a></p>
    <% } %>
  <% } else { %>
    <div class="empty">No store checklists have been submitted yet.</div>
  <% } %>

<%- include('../partials/footer') %>
