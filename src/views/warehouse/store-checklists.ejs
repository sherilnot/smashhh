<%- include('../partials/header', { title: 'Store Orders', role: 'warehouse_manager', active: 'store-checklists' }) %>

  <h1>Store Orders</h1>

  <% if (checklists.length === 0) { %>
    <div class="empty">No store checklists have been submitted yet.</div>
  <% } else { %>
    <div class="card" style="margin-bottom: 1rem;">
      <strong><%= total %></strong> checklist(s) received from stores.
    </div>

    <table>
      <thead>
        <tr>
          <th>Store</th>
          <th>Date</th>
          <th>Submitted By</th>
          <th>Submitted At</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% checklists.forEach(cl => { %>
          <tr>
            <td><strong><%= cl.store_name %></strong></td>
            <td><%= formatDate(cl.check_date) %></td>
            <td><%= cl.first_name %> <%= cl.last_name %></td>
            <td><%= cl.submitted_at ? formatDateTime(cl.submitted_at) : '—' %></td>
            <td>
              <span class="badge" style="background: <%= cl.status === 'reviewed' ? 'var(--lettuce)' : 'var(--mustard)' %>; color: <%= cl.status === 'reviewed' ? '#fff' : 'var(--bun-dark)' %>;">
                <%= cl.status %>
              </span>
            </td>
            <td><a href="/warehouse/store-checklists/<%= cl.id %>" class="btn" style="font-size: 0.8rem; padding: 0.35rem 0.7rem;">View</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <% if (totalPages > 1) { %>
      <div style="margin-top: 1rem; text-align: center;">
        <% if (page > 1) { %>
          <a href="/warehouse/store-checklists?page=<%= page - 1 %>" style="color: var(--lettuce-dark); font-weight: 700;">← Previous</a>
        <% } %>
        <span style="margin: 0 1rem; color: var(--muted);">Page <%= page %> of <%= totalPages %></span>
        <% if (page < totalPages) { %>
          <a href="/warehouse/store-checklists?page=<%= page + 1 %>" style="color: var(--lettuce-dark); font-weight: 700;">Next →</a>
        <% } %>
      </div>
    <% } %>
  <% } %>

<%- include('../partials/footer') %>
